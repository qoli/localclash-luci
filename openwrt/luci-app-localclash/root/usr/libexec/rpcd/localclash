json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

ok() {
	printf '{"ok":true,%s}\n' "$1"
}

fail() {
	code="$(json_escape "$1")"
	message="$(json_escape "$2")"
	printf '{"ok":false,"code":"%s","message":"%s","details":{},"next_actions":[]}\n' "$code" "$message"
}

fail_with_details() {
	code="$(json_escape "$1")"
	message="$(json_escape "$2")"
	details="$3"
	printf '{"ok":false,"code":"%s","message":"%s","details":{%s},"next_actions":[]}\n' "$code" "$message" "$details"
}

log_line() {
	printf '%s %s\n' "$(date -Iseconds 2>/dev/null || date)" "$*" >> "$LOG"
}

takeover_log_value() {
	printf '%s' "$1" | tr '\n\r\t' '   ' | LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

takeover_event_scope() {
	local boot_id
	[ -n "${LOCALCLASH_TAKEOVER_EVENT_ID:-}" ] && return 0
	boot_id="$(cat "$BOOT_ID_FILE" 2>/dev/null || printf 'unknown')"
	LOCALCLASH_TAKEOVER_EVENT_ID="${boot_id}:$(now_epoch):$$"
	export LOCALCLASH_TAKEOVER_EVENT_ID
}

takeover_log_lock_remove() {
	rmdir "$TAKEOVER_LOG_LOCK_DIR" 2>/dev/null || true
}

takeover_log_event() {
	local source event event_id timestamp boot_id uptime repair_ticket runtime_state boot_restore max_bytes keep_bytes size line key value lock_attempt
	source="$1"
	event="$2"
	shift 2
	timestamp="$(date -Iseconds 2>/dev/null || date)"
	boot_id="$(cat "$BOOT_ID_FILE" 2>/dev/null || printf 'unknown')"
	uptime="$(cut -d. -f1 "$PROC_UPTIME" 2>/dev/null || printf '0')"
	case "$uptime" in
		''|*[!0-9]*) uptime=0 ;;
	esac
	event_id="${LOCALCLASH_TAKEOVER_EVENT_ID:-${boot_id}:${uptime}:$$}"
	repair_ticket=false
	runtime_state=false
	boot_restore=false
	takeover_repair_ticket_enabled && repair_ticket=true
	takeover_runtime_state_enabled && runtime_state=true
	boot_auto_restore_enabled && boot_restore=true

	line="{\"timestamp\":\"$(takeover_log_value "$timestamp")\",\"boot_id\":\"$(takeover_log_value "$boot_id")\",\"uptime_seconds\":$uptime,\"event_id\":\"$(takeover_log_value "$event_id")\",\"source\":\"$(takeover_log_value "$source")\",\"event\":\"$(takeover_log_value "$event")\",\"repair_ticket\":$repair_ticket,\"runtime_state\":$runtime_state,\"boot_auto_restore\":$boot_restore"
	while [ "$#" -ge 2 ]; do
		key="$(printf '%s' "$1" | tr -cd 'A-Za-z0-9_')"
		value="$2"
		shift 2
		[ -n "$key" ] || continue
		line="${line},\"${key}\":\"$(takeover_log_value "$value")\""
	done
	line="${line}}"

	max_bytes="$TAKEOVER_LOG_MAX_BYTES"
	keep_bytes="$TAKEOVER_LOG_KEEP_BYTES"
	case "$max_bytes" in
		''|*[!0-9]*) max_bytes=262144 ;;
	esac
	case "$keep_bytes" in
		''|*[!0-9]*) keep_bytes=131072 ;;
	esac
	[ "$keep_bytes" -lt "$max_bytes" ] || keep_bytes=$((max_bytes / 2))

	(
		umask 077
		mkdir -p "$(dirname "$TAKEOVER_LOG")" || exit 1
		lock_attempt=0
		while ! mkdir "$TAKEOVER_LOG_LOCK_DIR" 2>/dev/null; do
			lock_attempt=$((lock_attempt + 1))
			[ "$lock_attempt" -lt 50 ] || exit 1
			sleep 0.1
		done
		trap 'takeover_log_lock_remove' EXIT INT TERM
		if [ -f "$TAKEOVER_LOG" ]; then
			size="$(wc -c < "$TAKEOVER_LOG" 2>/dev/null || printf '0')"
			case "$size" in
				''|*[!0-9]*) size=0 ;;
			esac
			if [ "$size" -ge "$max_bytes" ]; then
				tail -c "$keep_bytes" "$TAKEOVER_LOG" > "${TAKEOVER_LOG}.tail.$$" || exit 1
				sed '1d' "${TAKEOVER_LOG}.tail.$$" > "${TAKEOVER_LOG}.rotate.$$" || exit 1
				rm -f "${TAKEOVER_LOG}.tail.$$"
				mv -f "${TAKEOVER_LOG}.rotate.$$" "$TAKEOVER_LOG" || exit 1
			fi
		fi
		printf '%s\n' "$line" >> "$TAKEOVER_LOG"
		chmod 600 "$TAKEOVER_LOG" 2>/dev/null || true
		takeover_log_lock_remove
		trap - EXIT INT TERM
	)
}

takeover_log_event_safe() {
	local rc
	takeover_log_event "$@" && return 0
	rc=$?
	log_line "网络接管诊断：事件日志写入失败 path=$TAKEOVER_LOG rc=$rc"
	return "$rc"
}

takeover_trace() {
	local source event
	source="${1:-unknown}"
	event="${2:-unknown}"
	shift 2 2>/dev/null || true
	if takeover_log_event_safe "$source" "$event" "$@"; then
		ok '"recorded":true,"summary":"网络接管事件已记录。"'
		return 0
	fi
	fail "takeover_log_write_failed" "网络接管事件未能写入诊断日志。"
	return 1
}

