now_epoch() {
	date +%s 2>/dev/null || printf '0\n'
}

write_task_running() {
	local summary task
	summary="$1"
	task="${2:-task}"
	printf '{"ok":true,"running":true,"done":false,"started_at":%s,"task":"%s","summary":"%s"}\n' "$(now_epoch)" "$(json_escape "$task")" "$(json_escape "$summary")" > "$TASK_STATUS"
}

write_task_pid() {
	[ -n "$1" ] || return 0
	printf '%s\n' "$1" > "$TASK_PID"
}

task_started_at() {
	jsonfilter -i "$TASK_STATUS" -e '@.started_at' 2>/dev/null || printf '0\n'
}

task_name() {
	jsonfilter -i "$TASK_STATUS" -e '@.task' 2>/dev/null || printf 'task\n'
}

task_pid_alive() {
	local pid
	[ -f "$TASK_PID" ] || return 1
	pid="$(cat "$TASK_PID" 2>/dev/null)"
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

task_status_running() {
	[ "$(jsonfilter -i "$TASK_STATUS" -e '@.running' 2>/dev/null || true)" = "true" ]
}

write_task_done() {
	local rc result task started completed
	rc="$1"
	result="$2"
	task="$(task_name)"
	started="$(task_started_at)"
	completed="$(now_epoch)"
	case "$started" in
		""|*[!0-9]*) started=0 ;;
	esac
	printf '{"ok":true,"running":false,"done":true,"started_at":%s,"completed_at":%s,"task":"%s","exit_code":%s,"result":%s}\n' "$started" "$completed" "$(json_escape "$task")" "$rc" "$result" > "$TASK_STATUS"
}

lock_pid_alive() {
	local pid
	[ -f "$LOCK_DIR/pid" ] || return 1
	pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null
}

clear_stale_lock() {
	[ -d "$LOCK_DIR" ] || return 0
	if ! lock_pid_alive; then
		rm -rf "$LOCK_DIR" 2>/dev/null || true
		log_line "任务锁：已清理失效任务锁"
	fi
}

clear_stale_task_pid() {
	[ -f "$TASK_PID" ] || return 0
	task_pid_alive && return 0
	rm -f "$TASK_PID" 2>/dev/null || true
}

write_task_stale_result() {
	local result task message action
	task="$(jsonfilter -i "$TASK_STATUS" -e '@.task' 2>/dev/null || true)"
	case "$task" in
		one_click_update)
			message="一键更新任务已中断，请重试。"
			action="点击一键更新重试。"
			;;
		runtime_start_takeover)
			message="运行时启动和网络接管任务已中断，请重试。"
			action="点击启动并接管重试。"
			;;
		bootstrap_core)
			message="localClash 核心更新任务已中断，请重试。"
			action="点击安装 / 更新核心重试。"
			;;
		bootstrap_default)
			message="初始化任务已中断，请重试。"
			action="点击一键初始化重试。"
			;;
		component_update)
			message="组件更新任务已中断，请重试。"
			action="点击对应组件更新按钮重试。"
			;;
		luci_update)
			message="LuCI 界面更新任务已中断，请重试。"
			action="点击检查 LuCI 更新重试。"
			;;
		subscription_set)
			message="订阅设置任务已中断，请重试。"
			action="重新保存订阅设置。"
			;;
		custom_sites)
			message="自訂網站保存任务已中断，请重试。"
			action="重新保存自訂網站规则。"
			;;
		dnsqualify)
			message="dnsqualify 按需任务已中断，请重试。"
			action="重新运行 dnsqualify。"
			;;
		*)
			message="任务已中断，请重试。"
			action="重新执行刚才的操作。"
			;;
	esac
	result='{"ok":false,"code":"task_interrupted","message":"'"$(json_escape "$message")"'","details":{},"next_actions":["'"$(json_escape "$action")"'"]}'
	printf '%s\n' "$result" > "$TASK_RESULT"
	write_task_done 124 "$result"
}

reconcile_task_status() {
	local started age
	[ -f "$TASK_STATUS" ] || return 0
	task_status_running || return 0
	clear_stale_lock
	clear_stale_task_pid
	[ -d "$LOCK_DIR" ] && return 0
	task_pid_alive && return 0
	started="$(task_started_at)"
	age=$(( $(now_epoch) - started ))
	[ "$started" -gt 0 ] && [ "$age" -lt 10 ] && return 0
	if ! ps w 2>/dev/null | grep -q '[l]ocalclash .*_run'; then
		task_status_running || return 0
		log_line "任务状态：检测到后台任务已中断"
		write_task_stale_result
	fi
}

with_lock() {
	waited=0
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		clear_stale_lock
		if [ "$waited" -ge 120 ]; then
			log_line "等待任务锁超时：$*"
			fail "task_locked" "另一个 localClash 任务仍在运行，请稍后再试。"
			return 1
		fi
		waited=$((waited + 1))
		sleep 1
	done
	printf '%s\n' "$$" > "$LOCK_DIR/pid"
	trap 'rm -rf "$LOCK_DIR" 2>/dev/null || true' EXIT INT TERM
	"$@"
	rc=$?
	rm -rf "$LOCK_DIR" 2>/dev/null || true
	trap - EXIT INT TERM
	return "$rc"
}

with_update_check_lock() {
	local kind lock_dir lock_pid rc
	kind="$1"
	shift
	case "$kind" in
		core|luci) ;;
		*)
			fail "update_check_kind_invalid" "更新检查类型无效。"
			return 1
			;;
	esac
	lock_dir="${UPDATE_CHECK_LOCK_BASE}.${kind}"
	if [ -d "$lock_dir" ]; then
		lock_pid="$(cat "$lock_dir/pid" 2>/dev/null || true)"
		case "$lock_pid" in
			''|*[!0-9]*) lock_pid="" ;;
		esac
		if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
			log_line "更新检查：拒绝重叠 kind=$kind owner_pid=$lock_pid"
			fail "${kind}_update_check_in_progress" "同类型更新检查仍在运行，请等待当前检查完成后再试。"
			return 1
		fi
		rm -rf "$lock_dir"
	fi
	if ! mkdir "$lock_dir" 2>/dev/null; then
		log_line "更新检查：锁竞争 kind=$kind"
		fail "${kind}_update_check_in_progress" "同类型更新检查刚刚开始，请等待当前检查完成后再试。"
		return 1
	fi
	printf '%s\n' "$$" > "$lock_dir/pid"
	trap 'rm -rf "$lock_dir" 2>/dev/null || true' EXIT INT TERM
	"$@"
	rc=$?
	rm -rf "$lock_dir"
	trap - EXIT INT TERM
	return "$rc"
}

child_pids() {
	local parent status pid ppid
	parent="$1"
	for status in /proc/[0-9]*/status; do
		[ -r "$status" ] || continue
		pid="$(awk '$1 == "Pid:" { print $2; exit }' "$status" 2>/dev/null)"
		ppid="$(awk '$1 == "PPid:" { print $2; exit }' "$status" 2>/dev/null)"
		[ "$ppid" = "$parent" ] && [ -n "$pid" ] && printf '%s\n' "$pid"
	done
}

kill_process_tree() {
	local signal pid child
	signal="$1"
	pid="$2"
	[ -n "$pid" ] || return 0
	for child in $(child_pids "$pid"); do
		kill_process_tree "$signal" "$child"
	done
	kill "$signal" "$pid" 2>/dev/null || true
}

task_cancel() {
	local pid lock_pid result killed
	killed=0
	reconcile_task_status
	if ! task_pid_alive && ! lock_pid_alive; then
		log_line "任务控制：没有正在运行的任务可中止"
		if [ -f "$TASK_STATUS" ]; then
			cat "$TASK_STATUS"
		else
			fail "task_not_running" "当前没有正在运行的 localClash 任务。"
		fi
		return 0
	fi
	log_line "任务控制：收到中止请求"
	if [ -f "$TASK_PID" ]; then
		pid="$(cat "$TASK_PID" 2>/dev/null)"
		if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
			kill_process_tree -TERM "$pid"
			killed=1
		fi
	fi
	if [ -f "$LOCK_DIR/pid" ]; then
		lock_pid="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
		if [ -n "$lock_pid" ] && [ "$lock_pid" != "$pid" ] && kill -0 "$lock_pid" 2>/dev/null; then
			kill_process_tree -TERM "$lock_pid"
			killed=1
		fi
	fi
	if [ "$killed" -eq 1 ]; then
		sleep 2
		[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && kill_process_tree -KILL "$pid"
		[ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null && kill_process_tree -KILL "$lock_pid"
	fi
	rm -rf "$LOCK_DIR" 2>/dev/null || true
	rm -f "$TASK_PID" "$TASK_INPUT" 2>/dev/null || true
	result='{"ok":false,"code":"task_cancelled","message":"任务已中止。","details":{},"next_actions":["可以重新执行刚才的操作。"]}'
	printf '%s\n' "$result" > "$TASK_RESULT"
	write_task_done 130 "$result"
	log_line "任务控制：任务已中止"
	printf '%s\n' "$result"
}

run_with_heartbeat() {
	local label output tmp_output pid elapsed rc
	label="$1"
	output="$2"
	shift 2
	elapsed=0
	tmp_output="${output}.run.$$"
	rm -f "$tmp_output"
	( "$@" > "$tmp_output" ) &
	pid="$!"
	while kill -0 "$pid" 2>/dev/null; do
		sleep 5
		if kill -0 "$pid" 2>/dev/null; then
			elapsed=$((elapsed + 5))
			log_line "${label}：仍在执行（${elapsed}s）"
			if [ "$TASK_STEP_TIMEOUT" -gt 0 ] && [ "$elapsed" -ge "$TASK_STEP_TIMEOUT" ]; then
				log_line "${label}：超过 ${TASK_STEP_TIMEOUT}s，已停止等待"
				kill_process_tree -TERM "$pid"
				sleep 2
				kill_process_tree -KILL "$pid"
				wait "$pid" 2>/dev/null || true
				rm -f "$tmp_output"
				printf '{"ok":false,"code":"step_timeout","message":"%s 超时，请检查路由器是否能访问下载源，或稍后重试。","details":{"timeout_seconds":%s},"next_actions":["确认路由器可以访问下载源后重试。"]}\n' "$(json_escape "$label")" "$TASK_STEP_TIMEOUT" > "$output"
				return 124
			fi
		fi
	done
	wait "$pid"
	rc="$?"
	if [ -f "$tmp_output" ]; then
		mv "$tmp_output" "$output"
	else
		: > "$output"
	fi
	return "$rc"
}

fetch_single_url() {
	local url output downloader stderr_file started completed elapsed rc bytes host line failure_reason
	url="$1"
	output="$2"
	host="$(download_url_host "$url")"
	stderr_file="${output}.fetch-stderr.$$"
	started="$(now_epoch)"
	rm -f "$stderr_file" "$output"
	if command -v uclient-fetch >/dev/null 2>&1; then
		downloader="uclient-fetch"
		log_line "下载：开始 downloader=$downloader host=$host timeout=${FETCH_TIMEOUT}s"
		fetch_with_watchdog "$url" uclient-fetch -T "$FETCH_TIMEOUT" -q -O "$output" "$url" 2>"$stderr_file"
		rc=$?
	elif command -v wget >/dev/null 2>&1; then
		downloader="wget"
		log_line "下载：开始 downloader=$downloader host=$host timeout=${FETCH_TIMEOUT}s"
		fetch_with_watchdog "$url" wget -T "$FETCH_TIMEOUT" -q -O "$output" "$url" 2>"$stderr_file"
		rc=$?
	elif command -v curl >/dev/null 2>&1; then
		downloader="curl"
		log_line "下载：开始 downloader=$downloader host=$host timeout=${FETCH_TIMEOUT}s"
		fetch_with_watchdog "$url" curl --max-time "$FETCH_TIMEOUT" -fsSL "$url" -o "$output" 2>"$stderr_file"
		rc=$?
	else
		log_line "下载：失败 reason=downloader_missing host=$host"
		return 1
	fi
	if [ -s "$stderr_file" ]; then
		while IFS= read -r line; do
			log_line "下载器[$downloader]：$line"
		done < "$stderr_file"
	fi
	completed="$(now_epoch)"
	elapsed=$((completed - started))
	[ "$elapsed" -ge 0 ] 2>/dev/null || elapsed=0
	if [ -f "$output" ]; then
		bytes="$(wc -c < "$output" 2>/dev/null | tr -d ' ')"
	else
		bytes=0
	fi
	case "$bytes" in
		""|*[!0-9]*) bytes=0 ;;
	esac
	failure_reason=""
	if [ "$rc" -eq 0 ] && [ ! -f "$output" ]; then
		rc=1
		failure_reason="output_missing"
	elif [ "$rc" -eq 0 ] && [ "$bytes" -eq 0 ]; then
		rc=1
		failure_reason="output_empty"
	fi
	if [ "$rc" -eq 0 ]; then
		log_line "下载：成功 downloader=$downloader host=$host elapsed=${elapsed}s bytes=$bytes exit_code=$rc"
	else
		if [ -n "$failure_reason" ]; then
			log_line "下载：诊断 reason=$failure_reason detail=下载器退出码为0但未生成有效输出"
		fi
		if [ "$downloader" = "uclient-fetch" ] && grep -q '^Failed to send request: Operation not permitted$' "$stderr_file" 2>/dev/null; then
			log_line "下载：诊断 reason=connect_failed detail=uclient-fetch将内部连接错误码1误显示为Operation_not_permitted"
		fi
		log_download_dns_context "$host"
		log_line "下载：失败 downloader=$downloader host=$host elapsed=${elapsed}s bytes=$bytes exit_code=$rc"
	fi
	rm -f "$stderr_file"
	return "$rc"
}

download_url_host() {
	local authority
	authority="${1#*://}"
	authority="${authority%%/*}"
	authority="${authority##*@}"
	case "$authority" in
		\[*\]*)
			authority="${authority#\[}"
			printf '%s\n' "${authority%%\]*}"
			;;
		*)
			printf '%s\n' "${authority%%:*}"
			;;
	esac
}

log_download_dns_context() {
	local host dns_output dns_rc dns_summary
	host="$1"
	if [ -z "$host" ]; then
		log_line "下载：DNS诊断 status=skipped reason=host_missing"
		return 0
	fi
	if ! command -v nslookup >/dev/null 2>&1; then
		log_line "下载：DNS诊断 host=$host status=unavailable reason=nslookup_missing"
		return 0
	fi
	if command -v timeout >/dev/null 2>&1; then
		dns_output="$(timeout 3 nslookup "$host" 2>&1)"
		dns_rc=$?
	else
		dns_output="$(nslookup "$host" 2>&1)"
		dns_rc=$?
	fi
	dns_summary="$(printf '%s\n' "$dns_output" |
		sed -n '/^Name:/p; /^Address [0-9][0-9]*:/p; /^Address:/p' |
		tr '\r\n\t' '   ' |
		sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//' |
		cut -c 1-600)"
	[ -n "$dns_summary" ] || dns_summary="no_address"
	log_line "下载：DNS诊断 host=$host exit_code=$dns_rc result=$dns_summary"
}

fetch_with_watchdog() {
	local label pid watchdog elapsed rc watchdog_dir timeout_marker
	label="$1"
	shift
	watchdog_dir="$(mktemp -d /tmp/localclash-fetch-watchdog.XXXXXX)" || {
		log_line "下载：失败 reason=watchdog_state_unavailable"
		return 1
	}
	timeout_marker="$watchdog_dir/timed-out"
	"$@" &
	pid="$!"
	(
		elapsed=0
		while kill -0 "$pid" 2>/dev/null; do
			sleep 5
			if kill -0 "$pid" 2>/dev/null; then
				elapsed=$((elapsed + 5))
				log_line "下载：等待 ${label}（${elapsed}s）"
				if [ "$elapsed" -ge "$FETCH_TIMEOUT" ]; then
					: > "$timeout_marker"
					log_line "下载：超时 ${label} timeout=${FETCH_TIMEOUT}s"
					kill "$pid" 2>/dev/null || exit 0
					sleep 2
					kill -9 "$pid" 2>/dev/null || true
					exit 0
				fi
			fi
		done
	) &
	watchdog="$!"
	wait "$pid"
	rc="$?"
	kill "$watchdog" 2>/dev/null || true
	wait "$watchdog" 2>/dev/null || true
	if [ -f "$timeout_marker" ]; then
		rm -rf "$watchdog_dir"
		return 124
	fi
	rm -rf "$watchdog_dir"
	return "$rc"
}

probe_url_for_mirror() {
	local kind mirror
	kind="$1"
	mirror="$2"
	case "$kind:$mirror" in
		release:*)
			printf '%s/qoli/syncnext-api/main/pass.txt\n' "$(printf '%s' "$mirror" | sed 's#https://github.com#https://raw.githubusercontent.com#')"
			;;
		raw:https://fastly.jsdelivr.net/gh)
			printf 'https://fastly.jsdelivr.net/gh/qoli/syncnext-api@main/pass.txt\n'
			;;
		raw:*)
			printf '%s/qoli/syncnext-api/main/pass.txt\n' "$mirror"
			;;
	esac
}

mirror_probe_ok() {
	local kind mirror probe tmp body
	kind="$1"
	mirror="$2"
	probe="$(probe_url_for_mirror "$kind" "$mirror")"
	tmp="/tmp/localclash-mirror-probe.$$"
	rm -f "$tmp"
	log_line "下载：探测 $kind 镜像 $mirror"
	if ! fetch_single_url "$probe" "$tmp"; then
		rm -f "$tmp"
		return 1
	fi
	body="$(tr -d '\r\n' < "$tmp" 2>/dev/null)"
	rm -f "$tmp"
	[ "$body" = "pass" ]
}

select_github_mirror() {
	local kind mirrors mirror cache
	kind="$1"
	mirrors="$2"
	mkdir -p "$MIRROR_CACHE_DIR"
	cache="$MIRROR_CACHE_DIR/$kind"

	if [ -f "$cache" ]; then
		mirror="$(cat "$cache")"
		if [ -n "$mirror" ]; then
			printf '%s\n' "$mirror"
			return 0
		fi
	fi

	for mirror in $mirrors; do
		if mirror_probe_ok "$kind" "$mirror"; then
			printf '%s\n' "$mirror" > "$cache"
			log_line "下载：已选择 $kind 镜像 $mirror"
			printf '%s\n' "$mirror"
			return 0
		fi
	done

	rm -f "$cache"
	return 1
}

cache_github_mirror() {
	local kind mirror cache current
	kind="$1"
	mirror="$2"
	[ -n "$mirror" ] || return 0
	mkdir -p "$MIRROR_CACHE_DIR"
	cache="$MIRROR_CACHE_DIR/$kind"
	current="$(cat "$cache" 2>/dev/null || true)"
	if [ "$current" != "$mirror" ]; then
		printf '%s\n' "$mirror" > "$cache"
		log_line "下载：已确认 $kind 镜像 $mirror"
	fi
}

invalidate_github_mirror() {
	local kind mirror cache current
	kind="$1"
	mirror="$2"
	[ -n "$mirror" ] || return 0
	cache="$MIRROR_CACHE_DIR/$kind"
	current="$(cat "$cache" 2>/dev/null || true)"
	if [ "$current" = "$mirror" ]; then
		rm -f "$cache"
		log_line "下载：已丢弃 $kind 镜像 $mirror"
	fi
}

github_url_kind() {
	case "$1" in
		https://github.com/*) printf 'release\n' ;;
		https://raw.githubusercontent.com/*) printf 'raw\n' ;;
	esac
}

candidate_mirror_for_kind() {
	local kind candidate mirrors mirror
	kind="$1"
	candidate="$2"
	case "$kind" in
		release) mirrors="$GITHUB_RELEASE_MIRRORS" ;;
		raw) mirrors="$GITHUB_RAW_MIRRORS" ;;
		*) return 1 ;;
	esac
	for mirror in $mirrors; do
		case "$candidate" in
			"$mirror"/*)
				printf '%s\n' "$mirror"
				return 0
				;;
		esac
	done
	return 1
}

note_github_candidate_success() {
	local url candidate kind mirror
	url="$1"
	candidate="$2"
	kind="$(github_url_kind "$url")"
	[ -n "$kind" ] || return 0
	mirror="$(candidate_mirror_for_kind "$kind" "$candidate" || true)"
	cache_github_mirror "$kind" "$mirror"
}

note_github_candidate_failure() {
	local url candidate kind mirror
	url="$1"
	candidate="$2"
	kind="$(github_url_kind "$url")"
	[ -n "$kind" ] || return 0
	mirror="$(candidate_mirror_for_kind "$kind" "$candidate" || true)"
	invalidate_github_mirror "$kind" "$mirror"
}

raw_github_to_jsdelivr() {
	local rest owner repo branch path
	rest="${1#https://raw.githubusercontent.com/}"
	owner="${rest%%/*}"
	rest="${rest#*/}"
	repo="${rest%%/*}"
	rest="${rest#*/}"
	branch="${rest%%/*}"
	path="${rest#*/}"
	if [ -n "$owner" ] && [ -n "$repo" ] && [ -n "$branch" ] && [ -n "$path" ]; then
		printf 'https://fastly.jsdelivr.net/gh/%s/%s@%s/%s\n' "$owner" "$repo" "$branch" "$path"
	fi
}

github_download_candidates() {
	local url mirror selected
	url="$1"
	case "$GITHUB_MIRROR" in
		0|off|false|direct|none)
			printf '%s\n' "$url"
			return 0
			;;
	esac

	case "$url" in
		https://github.com/*)
			selected="$(select_github_mirror release "$GITHUB_RELEASE_MIRRORS" 2>/dev/null || true)"
			if [ -n "$selected" ]; then
				printf '%s%s\n' "$selected" "${url#https://github.com}"
			fi
			for mirror in $GITHUB_RELEASE_MIRRORS; do
				[ "$mirror" = "$selected" ] || printf '%s%s\n' "$mirror" "${url#https://github.com}"
			done
			;;
		https://raw.githubusercontent.com/*)
			selected="$(select_github_mirror raw "$GITHUB_RAW_MIRRORS" 2>/dev/null || true)"
			if [ -n "$selected" ]; then
				case "$selected" in
					https://fastly.jsdelivr.net/gh) raw_github_to_jsdelivr "$url" ;;
					*) printf '%s%s\n' "$selected" "${url#https://raw.githubusercontent.com}" ;;
				esac
			fi
			for mirror in $GITHUB_RAW_MIRRORS; do
				[ "$mirror" = "$selected" ] && continue
				case "$mirror" in
					https://fastly.jsdelivr.net/gh) raw_github_to_jsdelivr "$url" ;;
					*) printf '%s%s\n' "$mirror" "${url#https://raw.githubusercontent.com}" ;;
				esac
			done
			;;
	esac

	printf '%s\n' "$url"
}

commit_download_output() {
	local tmp output
	tmp="$1"
	output="$2"
	if mv "$tmp" "$output"; then
		return 0
	fi
	log_line "下载：提交失败 reason=atomic_move_failed"
	return 1
}

sha256_expected_from_file() {
	awk 'NF && $1 ~ /^[0-9A-Fa-f]+$/ && length($1) == 64 {print $1; exit}' "$1" 2>/dev/null | tr 'A-F' 'a-f'
}

fetch_url() {
	local url output tmp candidate
	url="$1"
	output="$2"
	tmp="$output.download.$$"
	rm -f "$tmp"
	for candidate in $(github_download_candidates "$url"); do
		log_line "下载：尝试 $candidate"
		if fetch_single_url "$candidate" "$tmp"; then
			commit_download_output "$tmp" "$output" || return 1
			note_github_candidate_success "$url" "$candidate"
			return 0
		fi
		note_github_candidate_failure "$url" "$candidate"
		rm -f "$tmp"
	done
	return 1
}

fetch_url_direct_first() {
	local url output tmp candidate switched
	url="$1"
	output="$2"
	switched=false
	tmp="$output.download.$$"
	rm -f "$tmp"
	log_line "下载：尝试 $url"
	if fetch_single_url "$url" "$tmp"; then
		commit_download_output "$tmp" "$output" || return 1
		return 0
	fi
	rm -f "$tmp"
	for candidate in $(github_download_candidates "$url"); do
		[ "$candidate" = "$url" ] && continue
		if [ "$switched" = false ]; then
			log_line "下载：正在切换 GitHub 镜像"
			switched=true
		fi
		log_line "下载：尝试 $candidate"
		if fetch_single_url "$candidate" "$tmp"; then
			commit_download_output "$tmp" "$output" || return 1
			note_github_candidate_success "$url" "$candidate"
			return 0
		fi
		note_github_candidate_failure "$url" "$candidate"
		rm -f "$tmp"
	done
	return 1
}

fetch_manifest() {
	local url output tmp candidate
	url="$1"
	output="$2"
	tmp="$output.download.$$"
	rm -f "$tmp"
	for candidate in $(github_download_candidates "$url"); do
		log_line "下载：尝试 $candidate"
		if fetch_single_url "$candidate" "$tmp"; then
			if jsonfilter -i "$tmp" -e '@.version' >/dev/null 2>&1; then
				commit_download_output "$tmp" "$output" || return 1
				note_github_candidate_success "$url" "$candidate"
				return 0
			fi
			log_line "下载：$candidate 返回的 Release 清单无效"
			note_github_candidate_failure "$url" "$candidate"
		else
			note_github_candidate_failure "$url" "$candidate"
		fi
		rm -f "$tmp"
	done
	return 1
}

fetch_url_verified_direct_first() {
	local url output expected_sha tmp candidate actual_sha switched
	url="$1"
	output="$2"
	expected_sha="$3"
	switched=false
	tmp="$output.download.$$"
	rm -f "$tmp"
	log_line "下载：尝试 $url"
	if fetch_single_url "$url" "$tmp"; then
		actual_sha="$(sha256sum "$tmp" | cut -d ' ' -f 1)"
		if [ "$actual_sha" = "$expected_sha" ]; then
			commit_download_output "$tmp" "$output" || return 1
			return 0
		fi
		log_line "下载：$url 校验和不匹配"
	fi
	rm -f "$tmp"
	for candidate in $(github_download_candidates "$url"); do
		[ "$candidate" = "$url" ] && continue
		if [ "$switched" = false ]; then
			log_line "下载：正在切换 GitHub 镜像"
			switched=true
		fi
		log_line "下载：尝试 $candidate"
		if fetch_single_url "$candidate" "$tmp"; then
			actual_sha="$(sha256sum "$tmp" | cut -d ' ' -f 1)"
			if [ "$actual_sha" = "$expected_sha" ]; then
				commit_download_output "$tmp" "$output" || return 1
				note_github_candidate_success "$url" "$candidate"
				return 0
			fi
			log_line "下载：$candidate 校验和不匹配"
			note_github_candidate_failure "$url" "$candidate"
		else
			note_github_candidate_failure "$url" "$candidate"
		fi
		rm -f "$tmp"
	done
	return 1
}

fetch_url_verified() {
	local url output expected_sha tmp candidate actual_sha
	url="$1"
	output="$2"
	expected_sha="$3"
	tmp="$output.download.$$"
	rm -f "$tmp"
	for candidate in $(github_download_candidates "$url"); do
		log_line "下载：尝试 $candidate"
		if fetch_single_url "$candidate" "$tmp"; then
			actual_sha="$(sha256sum "$tmp" | cut -d ' ' -f 1)"
			if [ "$actual_sha" = "$expected_sha" ]; then
				commit_download_output "$tmp" "$output" || return 1
				note_github_candidate_success "$url" "$candidate"
				return 0
			fi
			log_line "下载：$candidate 校验和不匹配"
			note_github_candidate_failure "$url" "$candidate"
		else
			note_github_candidate_failure "$url" "$candidate"
		fi
		rm -f "$tmp"
	done
	return 1
}

router_arch() {
	case "$(uname -m)" in
		aarch64|arm64) echo "arm64" ;;
		x86_64|amd64) echo "amd64" ;;
		*) return 1 ;;
	esac
}

core_installed() {
	[ -x "$CORE" ]
}

validate_state_dir_path() {
	local path
	path="$1"
	case "$path" in
		/*) ;;
		*)
			fail "invalid_state_dir" "localClash 工作目录必须是绝对路径。"
			return 1
			;;
	esac
	case "$path" in
		/|/bin|/dev|/etc|/lib|/lib64|/opt|/proc|/root|/sbin|/sys|/tmp|/usr|/var)
			fail "invalid_state_dir" "localClash 工作目录过于宽泛，拒绝执行。"
			return 1
			;;
	esac
	return 0
}

resolve_state_dir() {
	local workdir
	validate_state_dir_path "$STATE_DIR" || return 1
	mkdir -p "$STATE_DIR" || {
		fail "state_dir_create_failed" "无法创建 localClash 工作目录。"
		return 1
	}
	workdir="$(cd "$STATE_DIR" 2>/dev/null && pwd -P)" || {
		fail "state_dir_resolve_failed" "无法解析 localClash 工作目录。"
		return 1
	}
	validate_state_dir_path "$workdir" || return 1
	printf '%s\n' "$workdir"
}

call_core() {
	local workdir
	if ! core_installed; then
		fail "bootstrap_core_missing" "localClash 核心尚未安装。"
		return 1
	fi
	workdir="$(resolve_state_dir)" || return 1
	(cd / && LOCALCLASH_WORKDIR="$workdir" "$CORE" "$@") 2>>"$LOG"
}

call_takeover() {
	local workdir
	if [ ! -x "$TAKEOVER_MANAGER" ]; then
		fail_with_details "takeover_manager_missing" "OpenWrt 网络接管管理器尚未安装。" '"path":"'"$(json_escape "$TAKEOVER_MANAGER")"'"'
		return 1
	fi
	workdir="$(resolve_state_dir)" || return 1
	(cd / && LOCALCLASH_CORE="$CORE" LOCALCLASH_WORKDIR="$workdir" "$TAKEOVER_MANAGER" "$@") 2>>"$LOG"
}

runtime_stop() {
	local tmp takeover_tmp rc
	tmp="/tmp/localclash-runtime-stop.$$.json"
	takeover_tmp="/tmp/localclash-takeover-stop-before-runtime.$$.json"
	call_takeover stop --json > "$takeover_tmp"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		cat "$takeover_tmp" 2>/dev/null || true
		rm -f "$takeover_tmp" "$tmp"
		return "$rc"
	fi
	if call_core runtime stop --json > "$tmp"; then
		cat "$tmp"
		rm -f "$takeover_tmp" "$tmp"
		return 0
	fi
	rc=$?
	cat "$tmp" 2>/dev/null || true
	rm -f "$takeover_tmp" "$tmp"
	return "$rc"
}

runtime_start() {
	call_core runtime start --json
}

runtime_continuity_fail() {
	local code message phase partial changed details
	code="$1"
	message="$2"
	phase="$3"
	partial="$4"
	changed="$5"
	details="$6"
	printf '{"ok":false,"changed":%s,"outcome":"attention_required","partial":%s,"phase":"%s","code":"%s","message":"%s","details":{%s},"next_actions":[]}\n' \
		"$changed" \
		"$partial" \
		"$(json_escape "$phase")" \
		"$(json_escape "$code")" \
		"$(json_escape "$message")" \
		"$details"
}

runtime_continuity_core_error_details() {
	local path fields core_code core_message
	path="$1"
	fields="$(takeover_error_log_fields "$path")"
	core_code="$(printf '%s\n' "$fields" | sed -n '1p')"
	core_message="$(printf '%s\n' "$fields" | sed -n '2p')"
	printf '"core_code":"%s","core_message":"%s"' "$(json_escape "$core_code")" "$(json_escape "$core_message")"
}

runtime_restart_continuity_run() {
	local strategy expected_effective expected_profile source tmpdir before_effective before_runtime before_profile restart_ok runtime_after apply_ok post_effective post_runtime post_profile summary transition rc details
	strategy="$1"
	expected_effective="$2"
	expected_profile="$3"
	source="$4"

	case "$strategy" in
		hot_reload|process_restart) ;;
		*)
			runtime_continuity_fail "runtime_restart_strategy_invalid" "运行时重启策略无效。" "preflight" false false '"strategy":"'"$(json_escape "$strategy")"'"'
			return 1
			;;
	esac
	case "$expected_effective" in
		observe|true|false) ;;
		*)
			runtime_continuity_fail "runtime_restart_snapshot_invalid" "网络接管快照无效。" "preflight" false false '"takeover_effective":"'"$(json_escape "$expected_effective")"'"'
			return 1
			;;
	esac

	tmpdir="$(mktemp -d /tmp/localclash-runtime-restart.XXXXXX)" || {
		runtime_continuity_fail "runtime_restart_tmpdir_failed" "无法创建运行时重启临时目录。" "preflight" false false '"path":"/tmp/localclash-runtime-restart.XXXXXX"'
		return 1
	}
	takeover_event_scope
	takeover_log_event_safe "$source" "runtime_restart_started" "strategy" "$strategy" >/dev/null 2>&1 || true

	if call_takeover status --json > "$tmpdir/before.json"; then
		rc=0
	else
		rc=$?
	fi
	if [ "$rc" -ne 0 ]; then
		details="$(runtime_continuity_core_error_details "$tmpdir/before.json")"
		takeover_log_event_safe "$source" "runtime_restart_finished" "result" "failure" "stage" "preflight_status" "exit_code" "$rc" >/dev/null 2>&1 || true
		runtime_continuity_fail "runtime_restart_preflight_status_failed" "重启前无法读取网络接管状态，未执行重启。" "preflight_status" false false "$details"
		rm -rf "$tmpdir"
		return 1
	fi
	before_effective="$(jsonfilter -i "$tmpdir/before.json" -e '@.status.effective' 2>/dev/null || true)"
	before_runtime="$(jsonfilter -i "$tmpdir/before.json" -e '@.status.runtime_running' 2>/dev/null || true)"
	before_profile="$(jsonfilter -i "$tmpdir/before.json" -e '@.status.profile_mode' 2>/dev/null || true)"
	case "$before_effective" in true|false) ;; *)
		runtime_continuity_fail "runtime_restart_preflight_status_invalid" "重启前网络接管状态缺少有效的 effective 字段，未执行重启。" "preflight_status" false false '"effective":"'"$(json_escape "$before_effective")"'"'
		rm -rf "$tmpdir"
		return 1
	;; esac
	case "$before_runtime" in true|false) ;; *)
		runtime_continuity_fail "runtime_restart_preflight_status_invalid" "重启前网络接管状态缺少有效的 runtime_running 字段，未执行重启。" "preflight_status" false false '"runtime_running":"'"$(json_escape "$before_runtime")"'"'
		rm -rf "$tmpdir"
		return 1
	;; esac
	case "$before_profile" in normal|router) ;; *)
		runtime_continuity_fail "runtime_restart_preflight_status_invalid" "重启前网络接管状态缺少有效的 profile_mode 字段，未执行重启。" "preflight_status" false false '"profile_mode":"'"$(json_escape "$before_profile")"'"'
		rm -rf "$tmpdir"
		return 1
	;; esac
	if [ "$before_runtime" != "true" ]; then
		runtime_continuity_fail "runtime_restart_precondition_failed" "运行时当前未运行，拒绝执行重启。" "preflight_status" false false '"runtime_running":false'
		rm -rf "$tmpdir"
		return 1
	fi
	if [ "$expected_effective" = "false" ] && [ "$before_effective" != "false" ]; then
		runtime_continuity_fail "runtime_restart_snapshot_drift" "网络接管状态与操作快照不一致，未执行重启。" "preflight_status" false false '"expected_effective":'"$expected_effective"',"observed_effective":'"$before_effective"
		rm -rf "$tmpdir"
		return 1
	fi
	if [ "$expected_effective" = "observe" ]; then
		expected_effective="$before_effective"
		expected_profile="$before_profile"
	fi
	if [ "$expected_effective" = "true" ] && { [ "$expected_profile" != "router" ] || { [ "$before_effective" = "true" ] && [ "$before_profile" != "router" ]; }; }; then
		runtime_continuity_fail "runtime_restart_snapshot_inconsistent" "网络接管有效时 runtime profile 必须是 router，未执行重启。" "preflight_status" false false '"expected_profile":"'"$(json_escape "$expected_profile")"'","observed_profile":"'"$(json_escape "$before_profile")"'"'
		rm -rf "$tmpdir"
		return 1
	fi

	if call_core runtime restart --strategy "$strategy" --json > "$tmpdir/runtime.json"; then
		rc=0
	else
		rc=$?
	fi
	if [ "$rc" -ne 0 ]; then
		details="$(runtime_continuity_core_error_details "$tmpdir/runtime.json")"
		takeover_log_event_safe "$source" "runtime_restart_finished" "result" "failure" "stage" "runtime_restart" "exit_code" "$rc" >/dev/null 2>&1 || true
		runtime_continuity_fail "runtime_restart_failed" "运行时重启失败；网络接管恢复未执行。" "runtime_restart" true true "$details"
		rm -rf "$tmpdir"
		return 1
	fi
	restart_ok="$(jsonfilter -i "$tmpdir/runtime.json" -e '@.ok' 2>/dev/null || true)"
	if [ "$restart_ok" != "true" ]; then
		runtime_continuity_fail "runtime_restart_result_invalid" "运行时重启结果无效；网络接管恢复未执行。" "runtime_restart" true true '"ok":"'"$(json_escape "$restart_ok")"'"'
		rm -rf "$tmpdir"
		return 1
	fi

	if call_core runtime status --json > "$tmpdir/runtime-after.json"; then
		rc=0
	else
		rc=$?
	fi
	if [ "$rc" -ne 0 ]; then
		details="$(runtime_continuity_core_error_details "$tmpdir/runtime-after.json")"
		runtime_continuity_fail "runtime_restart_postflight_runtime_failed" "运行时已执行重启，但无法读取重启后的运行状态。" "runtime_verify" true true "$details"
		rm -rf "$tmpdir"
		return 1
	fi
	runtime_after="$(jsonfilter -i "$tmpdir/runtime-after.json" -e '@.status.running' 2>/dev/null || true)"
	if [ "$runtime_after" != "true" ]; then
		runtime_continuity_fail "runtime_not_running_after_restart" "运行时重启命令已完成，但进程没有保持运行。" "runtime_verify" true true '"runtime_running":"'"$(json_escape "$runtime_after")"'"'
		rm -rf "$tmpdir"
		return 1
	fi

	transition="preserved_inactive"
	printf 'null\n' > "$tmpdir/takeover-apply.json"
	if [ "$expected_effective" = "true" ]; then
		if takeover_apply "$source" > "$tmpdir/takeover-apply.json"; then
			rc=0
		else
			rc=$?
		fi
		if [ "$rc" -ne 0 ]; then
			details="$(runtime_continuity_core_error_details "$tmpdir/takeover-apply.json")"
			takeover_log_event_safe "$source" "runtime_restart_finished" "result" "failure" "stage" "takeover_restore" "exit_code" "$rc" >/dev/null 2>&1 || true
			runtime_continuity_fail "takeover_restore_failed" "运行时已重启，但网络接管恢复失败。" "takeover_restore" true true "$details"
			rm -rf "$tmpdir"
			return 1
		fi
		apply_ok="$(jsonfilter -i "$tmpdir/takeover-apply.json" -e '@.ok' 2>/dev/null || true)"
		if [ "$apply_ok" != "true" ]; then
			runtime_continuity_fail "takeover_restore_result_invalid" "运行时已重启，但网络接管恢复结果无效。" "takeover_restore" true true '"ok":"'"$(json_escape "$apply_ok")"'"'
			rm -rf "$tmpdir"
			return 1
		fi
		transition="restored"
	fi

	if call_takeover status --json > "$tmpdir/after.json"; then
		rc=0
	else
		rc=$?
	fi
	if [ "$rc" -ne 0 ]; then
		details="$(runtime_continuity_core_error_details "$tmpdir/after.json")"
		runtime_continuity_fail "runtime_restart_postflight_status_failed" "运行时已重启，但无法验证最终网络接管状态。" "takeover_verify" true true "$details"
		rm -rf "$tmpdir"
		return 1
	fi
	post_effective="$(jsonfilter -i "$tmpdir/after.json" -e '@.status.effective' 2>/dev/null || true)"
	post_runtime="$(jsonfilter -i "$tmpdir/after.json" -e '@.status.runtime_running' 2>/dev/null || true)"
	post_profile="$(jsonfilter -i "$tmpdir/after.json" -e '@.status.profile_mode' 2>/dev/null || true)"
	case "$post_effective" in true|false) ;; *)
		runtime_continuity_fail "runtime_restart_postflight_status_invalid" "运行时已重启，但最终网络接管 effective 状态无效。" "takeover_verify" true true '"effective":"'"$(json_escape "$post_effective")"'"'
		rm -rf "$tmpdir"
		return 1
	;; esac
	case "$post_runtime" in true|false) ;; *)
		runtime_continuity_fail "runtime_restart_postflight_status_invalid" "运行时已重启，但最终 runtime_running 状态无效。" "takeover_verify" true true '"runtime_running":"'"$(json_escape "$post_runtime")"'"'
		rm -rf "$tmpdir"
		return 1
	;; esac
	case "$post_profile" in normal|router) ;; *)
		runtime_continuity_fail "runtime_restart_postflight_status_invalid" "运行时已重启，但最终 profile_mode 状态无效。" "takeover_verify" true true '"profile_mode":"'"$(json_escape "$post_profile")"'"'
		rm -rf "$tmpdir"
		return 1
	;; esac
	if [ "$post_runtime" != "true" ] || [ "$post_effective" != "$expected_effective" ]; then
		runtime_continuity_fail "runtime_restart_postcondition_failed" "运行时已重启，但最终网络接管状态与重启前不一致。" "takeover_verify" true true '"expected_effective":'"$expected_effective"',"observed_effective":'"$post_effective"',"runtime_running":'"$post_runtime"
		rm -rf "$tmpdir"
		return 1
	fi
	if [ "$expected_effective" = "true" ] && [ "$post_profile" != "router" ]; then
		runtime_continuity_fail "runtime_restart_postcondition_failed" "运行时已重启，但最终 runtime profile 不再是 router。" "takeover_verify" true true '"profile_mode":"'"$(json_escape "$post_profile")"'"'
		rm -rf "$tmpdir"
		return 1
	fi

	if [ "$expected_effective" = "true" ]; then
		summary="运行时已重启，网络接管已恢复并验证生效。"
	else
		summary="运行时已重启，网络接管保持未启用。"
	fi
	takeover_log_event_safe "$source" "runtime_restart_finished" "result" "success" "strategy" "$strategy" "takeover_transition" "$transition" >/dev/null 2>&1 || true
	printf '{"ok":true,"changed":true,"outcome":"ready","summary":"%s","strategy":"%s","before":{"runtime_running":%s,"takeover_effective":%s,"profile_mode":"%s"},"runtime":%s,"takeover_restore":%s,"after":{"runtime_running":%s,"takeover_effective":%s,"profile_mode":"%s"},"takeover_transition":"%s"}\n' \
		"$(json_escape "$summary")" \
		"$(json_escape "$strategy")" \
		"$before_runtime" \
		"$before_effective" \
		"$(json_escape "$before_profile")" \
		"$(cat "$tmpdir/runtime.json")" \
		"$(cat "$tmpdir/takeover-apply.json")" \
		"$post_runtime" \
		"$post_effective" \
		"$(json_escape "$post_profile")" \
		"$(json_escape "$transition")"
	rm -rf "$tmpdir"
}

runtime_restart() {
