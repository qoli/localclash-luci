如果你使用 Codex，请先安装或更新 localclash-mcp-route-operator Skill：
- Skill 来源：https://github.com/qoli/localClash/tree/main/.codex/skills/localclash-mcp-route-operator
- 已有 localClash 源码时，在仓库根目录运行：scripts/install-codex-skill.sh
- 没有源码时，使用 Codex 的 skill-installer 从上述 GitHub 路径安装。

安装完成后，请刷新或重新打开当前 Codex 任务，并确认该 Skill 可用。Skill 负责约束 Agent 如何规划、观测和变更路由；MCP 负责连接真实路由器，两者不能互相替代。

MCP 地址：$endpoint

如果你使用 Claude Code，可以先执行：
claude mcp add --transport http localclash $endpoint

如果你使用 OpenCode，可以执行交互式添加：
opencode mcp add

添加时选择 remote MCP server，名称填写 localclash，URL 填写：
$endpoint

也可以手动在 opencode.json 中加入：
{
  \"\$schema\": \"https://opencode.ai/config.json\",
  \"mcp\": {
    \"localclash\": {
      \"type\": \"remote\",
      \"url\": \"$endpoint\",
      \"enabled\": true
    }
  }
}

在 OpenCode 对话中需要使用时，可以明确说明：use localclash。

MCP 配置完成后，请刷新或重启当前 Agent 会话，直到可以看到 localClash MCP 工具。工具可见后，先调用 localClash MCP 的 tools_list，再调用 environment_inspect。

后续操作必须遵守这些边界：
1. 先观测再变更，并区分持久配置意图、Mihomo 已加载状态、当前连接和限定时间日志；不要只凭配置推断实际流量。
2. 服务、应用或游戏应优先使用自己拥有的专用策略出口，不要为了单一服务覆盖“自动选择”等共享或默认策略组。
3. Draft 一旦触及 shared/default group，必须停止套用，先展示具体组、当前行为、影响范围和专用出口替代方案；只有用户明确点名确认该共享变更后才可继续。
4. 写入配置、加载运行时、重启服务或接管路由器网络是不同授权，不得互相推定；执行前应分别说明影响并等待确认。"
	fi
	ok "\"text\":\"$(json_escape "$text")\",\"endpoint\":\"$(json_escape "$endpoint")\""
}

service_ensure() {
	local dir tmp
	dir="$(dirname "$SERVICE")"
	tmp="$SERVICE.tmp.$$"
	if [ -L "$SERVICE" ] || { [ -e "$SERVICE" ] && [ ! -f "$SERVICE" ]; }; then
		fail_with_details "service_script_path_invalid" "localclash-mcp 服务脚本路径类型无效。" '"path":"'"$(json_escape "$SERVICE")"'"'
		return 1
	fi
	if ! mkdir -p "$dir"; then
		fail_with_details "service_script_dir_failed" "无法创建 localclash-mcp 服务脚本目录。" '"path":"'"$(json_escape "$dir")"'"'
		return 1
	fi
	rm -f "$tmp" 2>/dev/null || true
	if ! (umask 022; cat > "$tmp" <<EOF
#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

CORE="$CORE"
WORKDIR="$STATE_DIR"
MCP_ADDR="$MCP_ADDR"
HELPER="/usr/libexec/rpcd/localclash"

start_service() {
	if [ ! -x "\$CORE" ]; then
		echo "localClash 核心缺失：\$CORE" >&2
		return 1
	fi
	mkdir -p "\$WORKDIR"
	procd_open_instance mcp
	procd_set_param command /bin/sh -c 'mkdir -p "\$1" && WORKDIR_REAL="\$(cd "\$1" && pwd -P)" && cd / && LOCALCLASH_WORKDIR="\$WORKDIR_REAL" exec "\$2" mcp serve --addr "\$3" --path /mcp' localclash-mcp "\$WORKDIR" "\$CORE" "\$MCP_ADDR"
	procd_set_param respawn
	procd_close_instance
	if [ -x "\$HELPER" ]; then
		procd_open_instance boot_restore
		procd_set_param command /bin/sh -c 'sleep "\${LOCALCLASH_BOOT_RESTORE_DELAY:-20}"; exec "\$1" call boot_restore_startup_run' localclash-boot-restore "\$HELPER"
		procd_close_instance
	fi
}
EOF
); then
		rm -f "$tmp" 2>/dev/null || true
		fail_with_details "service_script_write_failed" "无法写入 localclash-mcp 服务脚本。" '"path":"'"$(json_escape "$SERVICE")"'"'
		return 1
	fi
	if ! chmod 755 "$tmp" || ! mv "$tmp" "$SERVICE"; then
		rm -f "$tmp" 2>/dev/null || true
		fail_with_details "service_script_install_failed" "无法原子安装 localclash-mcp 服务脚本。" '"path":"'"$(json_escape "$SERVICE")"'"'
		return 1
	fi
	log_line "服务脚本已确保存在：$SERVICE"
	ok '"changed":true,"summary":"MCP 服务脚本已确保存在。"'
}

service_start() {
	local ensure_result ready_result
	ensure_result="$(service_ensure)" || {
		if [ -n "$ensure_result" ]; then
			printf '%s\n' "$ensure_result"
		else
			fail "service_ensure_failed" "无法确保 localclash-mcp 服务脚本。"
		fi
		return 1
	}
	if ! core_installed; then
		fail "bootstrap_core_missing" "localClash 核心尚未安装。"
		return 1
	fi
	case "$MCP_HEALTH_ATTEMPTS" in
		""|*[!0-9]*|0)
			fail_with_details "mcp_health_attempts_invalid" "MCP 健康检查次数必须是正整数。" '"value":"'"$(json_escape "$MCP_HEALTH_ATTEMPTS")"'"'
			return 1
			;;
	esac
	if ! command -v jsonfilter >/dev/null 2>&1; then
		fail "jsonfilter_missing" "需要 jsonfilter 验证 localclash-mcp 服务状态。"
		return 1
	fi
	"$SERVICE" enable >/dev/null 2>&1 || {
		fail "service_enable_failed" "无法启用 localclash-mcp 服务。"
		return 1
	}
	if ! "$SERVICE" restart >/dev/null 2>&1; then
		fail "service_restart_failed" "无法重启 localclash-mcp 服务。"
		return 1
	fi
	# procd restart is asynchronous; allow the old instance to leave before
	# jointly polling the named instance and the HTTP endpoint.
	sleep 1
	ready_result="$(wait_for_mcp_ready)" || {
		printf '%s\n' "$ready_result"
		return 1
	}
	printf '%s\n' "$ready_result"
}

status() {
	local core_ok mihomo_ok dashboard_ok subscription_ok runtime_ok summary runtime_profile base_assets boot_restore luci_package
	core_ok="$(core_installed && echo true || echo false)"
	mihomo_ok="$(mihomo_core_installed && echo true || echo false)"
	dashboard_ok="$(dashboard_installed && echo true || echo false)"
	subscription_ok="$(subscription_configured && echo true || echo false)"
	runtime_ok="$(runtime_running && echo true || echo false)"
	runtime_profile="$(runtime_profile_body)"
	base_assets="$(base_assets_body)"
	boot_restore="$(boot_restore_json)"
	luci_package="$(luci_package_json)"
	summary='"components":{"mihomo":{"installed":'"$mihomo_ok"'},"dashboard":{"installed":'"$dashboard_ok"'}},"subscription":{"configured":'"$subscription_ok"'},"runtime":{"running":'"$runtime_ok"'}'
	printf '{"ok":true,"core":{"installed":%s,"path":"%s"},%s,%s,%s,%s,"mcp_service":{%s},"status":{"ok":true,"changed":false,"summary":"localClash LuCI 状态摘要。",%s,"status":{%s}}}\n' "$core_ok" "$CORE" "$base_assets" "$runtime_profile" "$boot_restore" "$luci_package" "$(service_body)" "$summary" "$summary"
}

component_update() {
	local payload component tmp rc
	payload="$(cat)"
	component="$(jsonfilter -s "$payload" -e '@.component' 2>/dev/null)"
	case "$component" in
		localclash) bootstrap_core ;;
		mihomo|dashboard)
			tmp="/tmp/localclash-component-$component.$$.json"
			log_line "组件更新：正在更新 $component"
			if run_with_heartbeat "组件更新：正在更新 $component" "$tmp" call_core component update "$component" --json; then
				log_line "组件更新：$component 已完成"
				cat "$tmp"
				rm -f "$tmp"
				return 0
			fi
			rc=$?
			log_line "组件更新：$component 更新失败"
			cat "$tmp"
			rm -f "$tmp"
			return "$rc"
			;;
		*) fail "invalid_component" "component 必须是 localclash、mihomo 或 dashboard。"; return 1 ;;
	esac
}

one_click_update_state_dir() {
	printf '/tmp/localclash-one-click-update.%s\n' "$$"
}

one_click_update_write_state() {
	local dir phase tmp
	dir="$1"
	phase="$2"
	tmp="$dir/state.json.tmp.$$"
	if ! (umask 077; printf '{"version":1,"task":"one_click_update","owner_pid":%s,"phase":"%s"}\n' "$$" "$(json_escape "$phase")" > "$tmp"); then
		rm -f "$tmp"
		fail "one_click_update_state_write_failed" "无法写入一键更新交接状态。"
		return 1
	fi
	if ! mv "$tmp" "$dir/state.json"; then
		rm -f "$tmp"
		fail "one_click_update_state_write_failed" "无法提交一键更新交接状态。"
		return 1
	fi
}

one_click_update_write_snapshot() {
	local dir sync_default_policy runtime_was_running takeover_was_effective profile_mode tmp
	dir="$1"
	sync_default_policy="$2"
	runtime_was_running="$3"
	takeover_was_effective="$4"
	profile_mode="$5"
	tmp="$dir/snapshot.json.tmp.$$"
	if ! (umask 077; printf '{"version":1,"sync_default_policy":%s,"runtime_was_running":%s,"takeover_was_effective":%s,"profile_mode":"%s"}\n' \
		"$sync_default_policy" "$runtime_was_running" "$takeover_was_effective" "$(json_escape "$profile_mode")" > "$tmp"); then
		rm -f "$tmp"
		fail "one_click_update_snapshot_write_failed" "无法写入一键更新运行时快照。"
		return 1
	fi
	if ! mv "$tmp" "$dir/snapshot.json"; then
		rm -f "$tmp"
		fail "one_click_update_snapshot_write_failed" "无法提交一键更新运行时快照。"
		return 1
	fi
}

one_click_update_validate_resume() {
	local dir lock_owner version task state_owner phase
	dir="$(one_click_update_state_dir)"
	if [ -L "$LOCK_DIR" ] || [ ! -d "$LOCK_DIR" ] || [ -L "$LOCK_DIR/pid" ] || [ ! -f "$LOCK_DIR/pid" ]; then
		fail "one_click_update_lock_missing" "一键更新交接所需的任务锁不存在或类型无效。"
		return 1
	fi
	lock_owner="$(cat "$LOCK_DIR/pid" 2>/dev/null)"
	case "$lock_owner" in
		""|*[!0-9]*)
			fail "one_click_update_lock_owner_invalid" "一键更新任务锁的 owner PID 无效。"
			return 1
			;;
	esac
	if [ "$lock_owner" != "$$" ]; then
		fail_with_details "one_click_update_lock_owner_mismatch" "新版 helper 无法接管不属于当前进程的一键更新任务锁。" '"expected_pid":'"$$"',"actual_pid":'"$lock_owner"
		return 1
	fi
	if [ -L "$dir" ] || [ ! -d "$dir" ] || [ -L "$dir/state.json" ] || [ ! -f "$dir/state.json" ] || [ -L "$dir/snapshot.json" ] || [ ! -f "$dir/snapshot.json" ] || [ -L "$dir/luci.json" ] || [ ! -f "$dir/luci.json" ]; then
		fail "one_click_update_state_missing" "一键更新交接状态缺失或类型无效。"
		return 1
	fi
	version="$(jsonfilter -i "$dir/state.json" -e '@.version' 2>/dev/null || true)"
	task="$(jsonfilter -i "$dir/state.json" -e '@.task' 2>/dev/null || true)"
	state_owner="$(jsonfilter -i "$dir/state.json" -e '@.owner_pid' 2>/dev/null || true)"
	phase="$(jsonfilter -i "$dir/state.json" -e '@.phase' 2>/dev/null || true)"
	if [ "$version" != "1" ]; then
		fail_with_details "one_click_update_state_version_unsupported" "一键更新交接状态版本不受支持。" '"version":"'"$(json_escape "$version")"'"'
		return 1
	fi
	if [ "$task" != "one_click_update" ]; then
		fail_with_details "one_click_update_state_invalid" "一键更新交接状态的任务类型无效。" '"task":"'"$(json_escape "$task")"'"'
		return 1
	fi
	if [ "$state_owner" != "$$" ]; then
		fail_with_details "one_click_update_state_owner_mismatch" "一键更新交接状态不属于当前进程。" '"expected_pid":'"$$"',"actual_pid":"'"$(json_escape "$state_owner")"'"'
		return 1
	fi
	if [ "$phase" != "awaiting_resume" ]; then
		fail_with_details "one_click_update_resume_phase_invalid" "一键更新交接状态不允许继续执行。" '"phase":"'"$(json_escape "$phase")"'"'
		return 1
	fi
}

one_click_update_reexec() {
	if [ -L "$HELPER_SELF" ] || [ ! -f "$HELPER_SELF" ] || [ ! -r "$HELPER_SELF" ] || [ ! -x "$HELPER_SELF" ]; then
		fail_with_details "one_click_update_helper_unavailable" "LuCI 更新后无法执行新版 localClash helper。" '"path":"'"$(json_escape "$HELPER_SELF")"'"'
		return 1
	fi
	if ! /bin/sh -n "$HELPER_SELF" >/dev/null 2>&1; then
		fail_with_details "one_click_update_helper_invalid" "LuCI 更新后的 localClash helper 无法通过 shell 语法检查。" '"path":"'"$(json_escape "$HELPER_SELF")"'"'
		return 1
	fi
	# Package replacement does not update functions already loaded by this
	# shell. exec preserves the lock-owning PID while /bin/sh loads the new file.
	exec /bin/sh "$HELPER_SELF" call one_click_update_resume
	fail_with_details "one_click_update_reexec_failed" "无法切换到新版 localClash helper 继续一键更新。" '"path":"'"$(json_escape "$HELPER_SELF")"'"'
	return 1
}

one_click_update_lock_owned() {
	local owner
	if [ -L "$LOCK_DIR" ] || [ ! -d "$LOCK_DIR" ] || [ -L "$LOCK_DIR/pid" ] || [ ! -f "$LOCK_DIR/pid" ]; then
		return 1
	fi
	owner="$(cat "$LOCK_DIR/pid" 2>/dev/null || true)"
	[ "$owner" = "$$" ]
}

one_click_update_resume_cleanup() {
	local dir
	dir="$(one_click_update_state_dir)"
	rm -rf "$dir" 2>/dev/null || true
	if one_click_update_lock_owned; then
		rm -rf "$LOCK_DIR" 2>/dev/null || true
	fi
}

one_click_update_resume() {
	local rc
	if ! one_click_update_validate_resume; then
		if one_click_update_lock_owned; then
			one_click_update_resume_cleanup
		fi
		return 1
	fi
	trap 'one_click_update_resume_cleanup' EXIT
	trap 'one_click_update_resume_cleanup; exit 130' INT
	trap 'one_click_update_resume_cleanup; exit 143' TERM
	if ! one_click_update_write_state "$(one_click_update_state_dir)" "continuing"; then
		one_click_update_resume_cleanup
		trap - EXIT INT TERM
		return 1
	fi
	ONE_CLICK_UPDATE_RESUME=1
	one_click_update_run
	rc=$?
	one_click_update_resume_cleanup
	trap - EXIT INT TERM
	return "$rc"
}

start_one_click_update() {
	local result rc bg_pid payload
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	payload="$(strip_ubus_rpc_session "$(cat)")"
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	write_versioned_payload "$payload" > "$TASK_INPUT"
	write_task_running "一键更新任务正在运行。" "one_click_update"
	log_line "一键更新：已加入后台任务队列"
	(
		result="$("$0" call one_click_update_run 2>>"$LOG")"
		rc=$?
		if [ -z "$result" ]; then
			result='{"ok":false,"code":"empty_task_result","message":"一键更新任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		fi
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_INPUT" "$TASK_PID"
		if [ "$rc" -eq 0 ] && one_click_update_luci_changed "$result"; then
			luci_schedule_service_reload
		fi
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"一键更新任务已启动。准备阶段不会停止当前运行时；只有最终切换运行时时可能短暂断网。"'
}

one_click_update_run() {
	local tmpdir payload snapshot version sync_default_policy runtime_was_running takeover_was_effective profile_mode luci_changed subscription_ready subscription_refresh_json policy_template_sync_json custom_sites_preservation custom_sites_before_fields custom_sites_after_fields dnsqualify_json mihomo_changed dashboard_changed runtime_recovered takeover_recovered mcp_healthy current_mode current_core software_checkpoint_json material_checkpoint_json
	tmpdir="$(one_click_update_state_dir)"
	if [ "${ONE_CLICK_UPDATE_RESUME:-0}" = "1" ]; then
		snapshot="$tmpdir/snapshot.json"
		version="$(jsonfilter -i "$snapshot" -e '@.version' 2>/dev/null || true)"
		if [ "$version" != "1" ]; then
			fail_with_details "one_click_update_snapshot_version_unsupported" "一键更新运行时快照版本不受支持。" '"version":"'"$(json_escape "$version")"'"'
			return 1
		fi
		sync_default_policy="$(json_bool_required "$snapshot" '@.sync_default_policy' "one_click_update_snapshot_invalid" "无法读取一键更新的策略同步快照。")" || {
			printf '%s\n' "$sync_default_policy"
			return 1
		}
		runtime_was_running="$(json_bool_required "$snapshot" '@.runtime_was_running' "one_click_update_snapshot_invalid" "无法读取一键更新前的运行时状态。")" || {
			printf '%s\n' "$runtime_was_running"
			return 1
		}
		takeover_was_effective="$(json_bool_required "$snapshot" '@.takeover_was_effective' "one_click_update_snapshot_invalid" "无法读取一键更新前的网络接管状态。")" || {
			printf '%s\n' "$takeover_was_effective"
			return 1
		}
		profile_mode="$(jsonfilter -i "$snapshot" -e '@.profile_mode' 2>/dev/null || true)"
		if takeover_restore_requested; then
			takeover_was_effective=true
			profile_mode=router
		fi
		log_line "一键更新：新版 helper 已接管更新任务"
	else
		if [ -e "$tmpdir" ] || [ -L "$tmpdir" ]; then
			fail_with_details "one_click_update_state_dir_exists" "一键更新状态目录已存在，拒绝复用。" '"path":"'"$(json_escape "$tmpdir")"'"'
			return 1
		fi
		if ! (umask 077; mkdir "$tmpdir"); then
			fail_with_details "one_click_update_state_dir_create_failed" "无法创建一键更新状态目录。" '"path":"'"$(json_escape "$tmpdir")"'"'
			return 1
		fi
		if ! one_click_update_write_state "$tmpdir" "preparing"; then
			rm -rf "$tmpdir"
			return 1
		fi
		payload='{"version":1}'
		if [ -f "$TASK_INPUT" ]; then
			payload="$(cat "$TASK_INPUT" 2>/dev/null || printf '{"version":1}')"
		fi
		sync_default_policy="$(jsonfilter -s "$payload" -e '@.sync_default_policy' 2>/dev/null || true)"
		case "$sync_default_policy" in
			true|false)
				sync_default_policy="$(one_click_update_preferences_set_value "$sync_default_policy")" || {
					printf '%s\n' "$sync_default_policy"
					rm -rf "$tmpdir"
					return 1
				}
				sync_default_policy="$(jsonfilter -s "$sync_default_policy" -e '@.preferences.one_click_update.sync_default_policy' 2>/dev/null || true)"
				;;
			"")
				sync_default_policy="$(one_click_update_sync_default_policy_preference)" || {
					printf '%s\n' "$sync_default_policy"
					rm -rf "$tmpdir"
					return 1
				}
				;;
			*)
				fail_with_details "invalid_one_click_update_input" "sync_default_policy 必须是 true 或 false。" '"sync_default_policy":"'"$(json_escape "$sync_default_policy")"'"'
				rm -rf "$tmpdir"
				return 1
				;;
		esac
		case "$sync_default_policy" in
			true|false) ;;
			*)
				fail_with_details "invalid_one_click_update_preferences" "一键更新偏好文件无效，请删除后重新设置。" '"sync_default_policy":"'"$(json_escape "$sync_default_policy")"'"'
				rm -rf "$tmpdir"
				return 1
				;;
		esac
		runtime_was_running=false
		takeover_was_effective=false
		profile_mode=""

		log_line "一键更新：开始"
		if core_installed; then
			log_line "一键更新：记录更新前运行时状态"
			if ! call_core runtime status --json > "$tmpdir/runtime-before.json"; then
				log_line "一键更新：运行时状态读取失败"
				cat "$tmpdir/runtime-before.json" 2>/dev/null || true
				rm -rf "$tmpdir"
				return 1
			fi
			runtime_was_running="$(json_bool_required "$tmpdir/runtime-before.json" '@.status.running' "runtime_status_invalid" "无法读取更新前运行时状态。")" || {
				printf '%s\n' "$runtime_was_running"
				rm -rf "$tmpdir"
				return 1
			}

			log_line "一键更新：记录更新前网络接管状态"
			if ! call_takeover status --json > "$tmpdir/takeover-before.json"; then
				log_line "一键更新：网络接管状态读取失败"
				cat "$tmpdir/takeover-before.json" 2>/dev/null || true
				rm -rf "$tmpdir"
				return 1
			fi
			takeover_was_effective="$(json_bool_required "$tmpdir/takeover-before.json" '@.status.effective' "takeover_status_invalid" "无法读取更新前网络接管状态。")" || {
				printf '%s\n' "$takeover_was_effective"
				rm -rf "$tmpdir"
				return 1
			}
			profile_mode="$(jsonfilter -i "$tmpdir/takeover-before.json" -e '@.status.profile_mode' 2>/dev/null || true)"
			if takeover_restore_requested; then
				takeover_was_effective=true
				profile_mode=router
			fi
		else
			log_line "一键更新：localClash 核心尚未安装，跳过运行时快照"
		fi
		if ! one_click_update_write_snapshot "$tmpdir" "$sync_default_policy" "$runtime_was_running" "$takeover_was_effective" "$profile_mode"; then
			rm -rf "$tmpdir"
			return 1
		fi
		if ! one_click_update_write_state "$tmpdir" "luci_updating"; then
			rm -rf "$tmpdir"
			return 1
		fi
		log_line "一键更新：准备阶段开始，当前运行时保持不动"
		if ! run_with_heartbeat "一键更新：正在更新 LuCI 界面" "$tmpdir/luci.json" luci_update; then
			log_line "一键更新：LuCI 更新失败"
			cat "$tmpdir/luci.json"
			rm -rf "$tmpdir"
			return 1
		fi
		luci_changed="$(json_bool_required "$tmpdir/luci.json" '@.changed' "luci_update_result_invalid" "无法读取 LuCI 更新结果的 changed 状态。")" || {
			printf '%s\n' "$luci_changed"
			rm -rf "$tmpdir"
			return 1
		}
		if [ "$luci_changed" = "true" ]; then
			if ! one_click_update_write_state "$tmpdir" "awaiting_resume"; then
				rm -rf "$tmpdir"
				return 1
			fi
			log_line "一键更新：LuCI helper 已更新，正在切换到新版 helper"
			if ! one_click_update_reexec; then
				rm -rf "$tmpdir"
				return 1
			fi
			fail "one_click_update_reexec_returned" "新版 helper 交接异常返回，已停止继续更新。"
			rm -rf "$tmpdir"
			return 1
		fi
		if ! one_click_update_write_state "$tmpdir" "continuing"; then
			rm -rf "$tmpdir"
			return 1
		fi
	fi

	subscription_ready=false
	subscription_refresh_json='null'
	policy_template_sync_json='{"ok":true,"changed":false,"skipped":true,"summary":"未选择同步最新默认策略。"}'
	custom_sites_preservation='null'
	dnsqualify_json='null'
	mihomo_changed=false
	dashboard_changed=false
	runtime_recovered=false
	takeover_recovered=false
	software_checkpoint_json='{"ok":true,"changed":false,"skipped":true,"summary":"更新前运行时未运行，跳过 Mihomo 软件切换。"}'
	material_checkpoint_json='{"ok":true,"changed":false,"skipped":true,"summary":"尚未执行订阅和配置材料切换。"}'

	if ! run_with_heartbeat "一键更新：正在更新 localClash 核心" "$tmpdir/core.json" bootstrap_core; then
		log_line "一键更新：localClash 核心更新失败"
		cat "$tmpdir/core.json"
		rm -rf "$tmpdir"
		return 1
	fi

	if ! run_with_heartbeat "一键更新：正在更新 dnsqualify" "$tmpdir/dnsqualify.json" dnsqualify_install; then
		log_line "一键更新：dnsqualify 更新失败"
		cat "$tmpdir/dnsqualify.json"
		rm -rf "$tmpdir"
		return 1
	fi
	dnsqualify_json="$(cat "$tmpdir/dnsqualify.json")"

	if ! service_status > "$tmpdir/mcp-service.json"; then
		log_line "一键更新：MCP 服务状态读取失败"
		cat "$tmpdir/mcp-service.json"
		rm -rf "$tmpdir"
		return 1
	fi
	mcp_healthy="$(json_bool_required "$tmpdir/mcp-service.json" '@.mcp.healthy' "mcp_service_status_invalid" "无法读取 MCP 服务健康状态。")" || {
		printf '%s\n' "$mcp_healthy"
		rm -rf "$tmpdir"
		return 1
	}
	if [ "$mcp_healthy" != "true" ]; then
		log_line "一键更新：MCP 服务健康检查未通过"
		fail "mcp_service_unhealthy" "localClash 核心已更新，但 MCP 服务健康检查未通过。"
		rm -rf "$tmpdir"
		return 1
	fi

	if ! run_with_heartbeat "一键更新：正在更新 Mihomo 核心" "$tmpdir/mihomo.json" call_core component update mihomo --json; then
		log_line "一键更新：Mihomo 核心更新失败"
		cat "$tmpdir/mihomo.json"
		rm -rf "$tmpdir"
		return 1
	fi
	mihomo_changed="$(json_bool_required "$tmpdir/mihomo.json" '@.changed' "component_update_result_invalid" "无法读取 Mihomo 核心更新结果。")" || {
		printf '%s\n' "$mihomo_changed"
		rm -rf "$tmpdir"
		return 1
	}
	if [ "$runtime_was_running" = "true" ]; then
		if ! run_with_heartbeat "一键更新：正在验证 Mihomo 软件检查点" "$tmpdir/software-config-test.json" call_core mihomo config-test --json; then
			log_line "一键更新：新 Mihomo 未通过现行配置验证"
			cat "$tmpdir/software-config-test.json"
			rm -rf "$tmpdir"
			return 1
		fi
		if ! run_with_heartbeat "一键更新：正在提交 Mihomo 软件检查点" "$tmpdir/software-checkpoint.json" runtime_restart_continuity_run process_restart "$takeover_was_effective" "$profile_mode" one_click_update_software; then
			log_line "一键更新：Mihomo 软件检查点提交失败"
			cat "$tmpdir/software-checkpoint.json"
			rm -rf "$tmpdir"
			return 1
		fi
		software_checkpoint_json="$(cat "$tmpdir/software-checkpoint.json")"
		runtime_recovered="$(json_bool_required "$tmpdir/software-checkpoint.json" '@.after.runtime_running' "software_checkpoint_invalid" "无法读取软件检查点的运行时状态。")" || {
			printf '%s\n' "$runtime_recovered"
			rm -rf "$tmpdir"
			return 1
		}
		takeover_recovered="$(json_bool_required "$tmpdir/software-checkpoint.json" '@.after.takeover_effective' "software_checkpoint_invalid" "无法读取软件检查点的网络接管状态。")" || {
			printf '%s\n' "$takeover_recovered"
			rm -rf "$tmpdir"
			return 1
		}
		log_line "一键更新：Mihomo 软件检查点已完成"
	else
		log_line "一键更新：更新前运行时未运行，Mihomo 软件已安装但不启动"
	fi

	if ! run_with_heartbeat "一键更新：正在更新 Dashboard" "$tmpdir/dashboard.json" call_core component update dashboard --json; then
		log_line "一键更新：Dashboard 更新失败"
		cat "$tmpdir/dashboard.json"
		rm -rf "$tmpdir"
		return 1
	fi
	dashboard_changed="$(json_bool_required "$tmpdir/dashboard.json" '@.changed' "component_update_result_invalid" "无法读取 Dashboard 更新结果。")" || {
		printf '%s\n' "$dashboard_changed"
		rm -rf "$tmpdir"
		return 1
	}

	log_line "一键更新：检查已保存订阅"
	if ! call_core subscription status --json > "$tmpdir/subscription-status.json"; then
		log_line "一键更新：订阅状态读取失败"
		cat "$tmpdir/subscription-status.json" 2>/dev/null || true
		rm -rf "$tmpdir"
		return 1
	fi
	subscription_ready="$(json_bool_required "$tmpdir/subscription-status.json" '@.status.configured' "subscription_status_invalid" "无法读取订阅配置状态。")" || {
		printf '%s\n' "$subscription_ready"
		rm -rf "$tmpdir"
		return 1
	}
	if [ "$subscription_ready" = "true" ]; then
		if ! run_with_heartbeat "一键更新：正在刷新订阅" "$tmpdir/subscription-refresh.json" call_core subscription refresh --json; then
			log_line "一键更新：订阅刷新失败；软件检查点保持生效，配置材料未切换"
			cat "$tmpdir/subscription-refresh.json"
			rm -rf "$tmpdir"
			return 1
		fi
		subscription_refresh_json="$(cat "$tmpdir/subscription-refresh.json")"
	else
		subscription_refresh_json='{"ok":true,"changed":false,"summary":"未配置订阅，跳过订阅和配置材料检查点。","skipped":true}'
		material_checkpoint_json='{"ok":true,"changed":false,"skipped":true,"summary":"未配置订阅，现行运行时材料保持不变。"}'
		log_line "一键更新：未配置订阅，跳过订阅和配置材料检查点"
	fi

	if [ "$subscription_ready" = "true" ] && [ "$sync_default_policy" = "true" ]; then
		log_line "一键更新：准备同步最新默认策略"
		if ! call_core custom-sites list --json > "$tmpdir/custom-sites-before.json"; then
			log_line "一键更新：无法读取同步前的用户自定义网站列表"
			cat "$tmpdir/custom-sites-before.json" 2>/dev/null || true
			rm -rf "$tmpdir"
			return 1
		fi
		custom_sites_before_fields="$(custom_sites_preservation_fields "$tmpdir/custom-sites-before.json")" || {
			printf '%s\n' "$custom_sites_before_fields"
			rm -rf "$tmpdir"
			return 1
		}
		if ! call_core config status --json > "$tmpdir/config-status.json"; then
			log_line "一键更新：配置状态读取失败，无法同步默认策略"
			cat "$tmpdir/config-status.json" 2>/dev/null || true
			rm -rf "$tmpdir"
			return 1
		fi
		current_mode="$(jsonfilter -i "$tmpdir/config-status.json" -e '@.status.runtime_profile.mode' 2>/dev/null || true)"
		current_core="$(jsonfilter -i "$tmpdir/config-status.json" -e '@.status.runtime_profile.core' 2>/dev/null || true)"
		case "$current_mode" in
			normal|router) ;;
			*)
				fail_with_details "runtime_profile_status_invalid" "无法读取当前 runtime profile mode，已停止同步默认策略。" '"mode":"'"$(json_escape "$current_mode")"'"'
				rm -rf "$tmpdir"
				return 1
				;;
		esac
		case "$current_core" in
			meta|smart) ;;
			*)
				fail_with_details "runtime_profile_status_invalid" "无法读取当前 runtime core，已停止同步默认策略。" '"core":"'"$(json_escape "$current_core")"'"'
				rm -rf "$tmpdir"
				return 1
				;;
		esac
		cat > "$tmpdir/template-sync.json" <<JSON
{
  "version": 1,
  "template": "localclash-default",
  "runtime_profile": "$current_mode",
  "core": "$current_core",
  "allow_overwrite_modified": true,
  "reset_patches": true
}
JSON
		if ! run_with_heartbeat "一键更新：正在同步最新默认策略" "$tmpdir/policy-template-sync.json" call_core config apply-template --input "$tmpdir/template-sync.json" --json; then
			log_line "一键更新：默认策略同步失败"
			cat "$tmpdir/policy-template-sync.json"
			rm -rf "$tmpdir"
			return 1
		fi
		policy_template_sync_json="$(cat "$tmpdir/policy-template-sync.json")"
		if ! call_core custom-sites list --json > "$tmpdir/custom-sites-after.json"; then
			log_line "一键更新：无法读取同步后的用户自定义网站列表"
			cat "$tmpdir/custom-sites-after.json" 2>/dev/null || true
			rm -rf "$tmpdir"
			return 1
		fi
		custom_sites_after_fields="$(custom_sites_preservation_fields "$tmpdir/custom-sites-after.json")" || {
			printf '%s\n' "$custom_sites_after_fields"
			rm -rf "$tmpdir"
			return 1
		}
		if [ "$custom_sites_before_fields" != "$custom_sites_after_fields" ]; then
			fail_with_details "custom_sites_preservation_failed" "同步最新默认策略后，用户自定义网站列表的数量或 SHA256 发生变化。" '"before":'"$(custom_sites_preservation_json "$custom_sites_before_fields")"',"after":'"$(custom_sites_preservation_json "$custom_sites_after_fields")"
			rm -rf "$tmpdir"
			return 1
		fi
		custom_sites_preservation='{"verified":true,"before":'"$(custom_sites_preservation_json "$custom_sites_before_fields")"',"after":'"$(custom_sites_preservation_json "$custom_sites_after_fields")"'}'
		log_line "一键更新：用户自定义网站列表已验证保留"
	else
		log_line "一键更新：未选择同步最新默认策略"
	fi

	if [ "$subscription_ready" = "true" ]; then
		if ! run_with_heartbeat "一键更新：正在生成 Mihomo 配置" "$tmpdir/render.json" call_core config render --json; then
			log_line "一键更新：配置生成失败"
			cat "$tmpdir/render.json"
			rm -rf "$tmpdir"
			return 1
		fi
		if ! run_with_heartbeat "一键更新：正在验证 Mihomo 配置" "$tmpdir/config-test.json" call_core mihomo config-test --json; then
			log_line "一键更新：Mihomo 配置验证失败"
			cat "$tmpdir/config-test.json"
			rm -rf "$tmpdir"
			return 1
		fi
		if [ "$runtime_was_running" = "true" ]; then
			if ! run_with_heartbeat "一键更新：正在提交配置材料检查点" "$tmpdir/material-checkpoint.json" runtime_restart_continuity_run hot_reload "$takeover_was_effective" "$profile_mode" one_click_update_material; then
				log_line "一键更新：配置材料检查点提交失败"
				cat "$tmpdir/material-checkpoint.json"
				rm -rf "$tmpdir"
				return 1
			fi
			material_checkpoint_json="$(cat "$tmpdir/material-checkpoint.json")"
			runtime_recovered="$(json_bool_required "$tmpdir/material-checkpoint.json" '@.after.runtime_running' "material_checkpoint_invalid" "无法读取材料检查点的运行时状态。")" || {
				printf '%s\n' "$runtime_recovered"
				rm -rf "$tmpdir"
				return 1
			}
			takeover_recovered="$(json_bool_required "$tmpdir/material-checkpoint.json" '@.after.takeover_effective' "material_checkpoint_invalid" "无法读取材料检查点的网络接管状态。")" || {
				printf '%s\n' "$takeover_recovered"
				rm -rf "$tmpdir"
				return 1
			}
		else
			material_checkpoint_json='{"ok":true,"changed":true,"activated":false,"summary":"订阅和配置材料已生成并验证；运行时原本未运行，因此未执行热加载。"}'
		fi
	fi

	if [ "$takeover_was_effective" = "true" ]; then
		if [ "$takeover_recovered" != "true" ]; then
			log_line "一键更新：接管恢复后仍未生效"
			fail "takeover_restore_failed" "更新已完成，但网络接管恢复后仍未生效。"
			rm -rf "$tmpdir"
			return 1
		fi
	else
		if [ "$runtime_was_running" = "true" ] && [ "$takeover_recovered" != "false" ]; then
			log_line "一键更新：更新前网络接管未生效，但切换后状态发生变化"
			fail "takeover_state_changed_unexpectedly" "更新前网络接管未生效，但运行时切换后网络接管状态发生变化。"
			rm -rf "$tmpdir"
			return 1
		fi
		log_line "一键更新：网络接管保持未启用"
	fi

	if ! service_status > "$tmpdir/mcp-service-final.json"; then
		log_line "一键更新：最终 MCP 服务状态读取失败"
		cat "$tmpdir/mcp-service-final.json"
		rm -rf "$tmpdir"
		return 1
	fi
	mcp_healthy="$(json_bool_required "$tmpdir/mcp-service-final.json" '@.mcp.healthy' "mcp_service_status_invalid" "无法读取最终 MCP 服务健康状态。")" || {
		printf '%s\n' "$mcp_healthy"
		rm -rf "$tmpdir"
		return 1
	}
	if [ "$mcp_healthy" != "true" ]; then
		log_line "一键更新：最终 MCP 服务健康检查未通过"
		fail "mcp_service_unhealthy" "一键更新已执行，但 MCP 服务健康检查未通过。"
		rm -rf "$tmpdir"
		return 1
	fi

	if ! one_click_update_write_state "$tmpdir" "completed"; then
		rm -rf "$tmpdir"
		return 1
	fi
	log_line "一键更新：已完成"
	printf '{"ok":true,"changed":true,"summary":"一键更新已完成。","checkpoints":{"software":%s,"material":%s},"runtime":{"was_running":%s,"recovered":%s},"takeover":{"desired_enabled":%s,"recovered":%s},"luci":%s,"core":%s,"dnsqualify":%s,"mihomo":%s,"dashboard":%s,"policy_template_sync":%s,"custom_sites_preservation":%s,"subscription":{"configured":%s,"refresh":%s},"mcp_service":%s}\n' \
		"$software_checkpoint_json" \
		"$material_checkpoint_json" \
		"$runtime_was_running" \
		"$runtime_recovered" \
		"$takeover_was_effective" \
		"$takeover_recovered" \
		"$(cat "$tmpdir/luci.json")" \
		"$(cat "$tmpdir/core.json")" \
		"$dnsqualify_json" \
		"$(cat "$tmpdir/mihomo.json")" \
		"$(cat "$tmpdir/dashboard.json")" \
		"$policy_template_sync_json" \
		"$custom_sites_preservation" \
		"$subscription_ready" \
		"$subscription_refresh_json" \
		"$(cat "$tmpdir/mcp-service-final.json")"
	rm -rf "$tmpdir"
}

start_bootstrap_core() {
	local result rc bg_pid
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	write_task_running "localClash 核心更新任务正在运行。" "bootstrap_core"
	log_line "核心初始化：已加入后台任务队列"
	(
		result="$("$0" call bootstrap_core_run 2>>"$LOG")"
		rc=$?
		if [ -z "$result" ]; then
			result='{"ok":false,"code":"empty_task_result","message":"localClash 核心更新任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		fi
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_PID"
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"localClash 核心更新任务已启动。"'
}

start_component_update() {
	local payload component result rc bg_pid
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	payload="$(strip_ubus_rpc_session "$(cat)")"
	component="$(jsonfilter -s "$payload" -e '@.component' 2>/dev/null)"
	case "$component" in
		localclash|mihomo|dashboard) ;;
		*) fail "invalid_component" "component 必须是 localclash、mihomo 或 dashboard。"; return 1 ;;
	esac
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	printf '%s\n' "$payload" > "$TASK_INPUT"
	write_task_running "组件更新任务正在运行。" "component_update"
	log_line "组件更新：$component 已加入后台任务队列"
	(
		result="$("$0" call component_update_run 2>>"$LOG")"
		rc=$?
		if [ -z "$result" ]; then
			result='{"ok":false,"code":"empty_task_result","message":"组件更新任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		fi
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_INPUT" "$TASK_PID"
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"组件更新任务已启动。"'
}

component_update_run() {
	if [ ! -f "$TASK_INPUT" ]; then
		fail "task_input_missing" "组件更新任务输入缺失。"
		return 1
	fi
	with_lock component_update < "$TASK_INPUT"
}

start_luci_update() {
	local result rc bg_pid
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	write_task_running "LuCI 界面更新任务正在运行。" "luci_update"
	log_line "LuCI 更新：已加入后台任务队列"
	(
		result="$("$0" call luci_update_run 2>>"$LOG")"
		rc=$?
		if [ -z "$result" ]; then
			result='{"ok":false,"code":"empty_task_result","message":"LuCI 更新任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		fi
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_PID"
		if [ "$rc" -eq 0 ] && luci_update_changed "$result"; then
			luci_schedule_service_reload
		fi
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"LuCI 界面更新任务已启动。"'
}

luci_update_run() {
	with_lock luci_update_run_locked
}

luci_update_run_locked() {
	local result rc changed service_result
	result="$(luci_update)"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		if [ -n "$result" ]; then
			printf '%s\n' "$result"
		else
			fail "luci_update_failed" "LuCI 更新失败且没有返回结果。"
		fi
		return "$rc"
	fi
	changed="$(jsonfilter -s "$result" -e '@.changed' 2>/dev/null || true)"
	case "$changed" in
		false)
			printf '%s\n' "$result"
			return 0
			;;
		true) ;;
		*)
			fail_with_details "luci_update_result_invalid" "无法读取 LuCI 更新结果的 changed 状态。" '"changed":"'"$(json_escape "$changed")"'"'
			return 1
			;;
	esac
	if core_installed; then
		if [ -L "$HELPER_SELF" ] || [ ! -f "$HELPER_SELF" ] || [ ! -r "$HELPER_SELF" ] || [ ! -x "$HELPER_SELF" ]; then
			fail_with_details "luci_update_helper_unavailable" "LuCI 更新后无法执行新版 localClash helper。" '"path":"'"$(json_escape "$HELPER_SELF")"'"'
			return 1
		fi
		if ! /bin/sh -n "$HELPER_SELF" >/dev/null 2>&1; then
			fail_with_details "luci_update_helper_invalid" "LuCI 更新后的 localClash helper 无法通过 shell 语法检查。" '"path":"'"$(json_escape "$HELPER_SELF")"'"'
			return 1
		fi
		log_line "LuCI 更新：正在由新版 helper 重启 localclash-mcp"
		service_result="$(/bin/sh "$HELPER_SELF" call service_start)"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			if [ -n "$service_result" ]; then
				printf '%s\n' "$service_result"
			else
				fail "service_start_failed" "LuCI 已更新，但新版 helper 无法重启 localclash-mcp。"
			fi
			return "$rc"
		fi
	fi
	printf '%s\n' "$result"
}

input_to_core_file() {
	local payload tmp rc
	payload="$(cat)"
	payload="$(strip_ubus_rpc_session "$payload")"
	tmp="/tmp/localclash-input-$$.json"
	write_versioned_payload "$payload" > "$tmp"
	call_core "$@" --input "$tmp" --json
	rc=$?
	rm -f "$tmp"
	return "$rc"
}

strip_ubus_rpc_session() {
	printf '%s' "$1" | sed \
		-e 's/"ubus_rpc_session"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,[[:space:]]*//' \
		-e 's/,[[:space:]]*"ubus_rpc_session"[[:space:]]*:[[:space:]]*"[^"]*"//' \
		-e 's/{[[:space:]]*"ubus_rpc_session"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*}/{}/'
}

write_versioned_payload() {
	local payload body
	payload="$1"
	if printf '%s' "$payload" | jsonfilter -e '@.version' >/dev/null 2>&1; then
		printf '%s' "$payload"
		return 0
	fi

	body="$(printf '%s' "$payload" | sed 's/^[[:space:]]*{//; s/}[[:space:]]*$//')"
	if [ -n "$body" ]; then
		printf '{"version":1,%s}' "$body"
	else
		printf '{"version":1}'
	fi
}

subscription_set() {
