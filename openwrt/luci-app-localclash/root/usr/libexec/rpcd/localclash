	"$DNSQUALIFY" --version 2>/dev/null | sed -n 's/^dnsqualify \(v[^ ]*\)$/\1/p' | head -n 1
}

dnsqualify_install() {
	local arch tmpdir manifest binary manifest_schema asset_os asset_url asset_sha asset_version current_sha reported_version install_dir tmp_binary
	if ! command -v jsonfilter >/dev/null 2>&1; then
		fail "jsonfilter_missing" "需要 jsonfilter 解析 dnsqualify Release 清单。"
		return 1
	fi
	if ! command -v sha256sum >/dev/null 2>&1; then
		fail "sha256sum_missing" "需要 sha256sum 验证 dnsqualify 二进制文件。"
		return 1
	fi
	arch="$(router_arch)" || {
		fail "dnsqualify_unsupported_arch" "dnsqualify 不支持此路由器架构。"
		return 1
	}
	tmpdir="$(mktemp -d /tmp/localclash-dnsqualify-install.XXXXXX)" || {
		fail "tmpdir_failed" "无法创建 dnsqualify 安装临时目录。"
		return 1
	}
	manifest="$tmpdir/manifest.json"
	binary="$tmpdir/dnsqualify"
	log_line "dnsqualify：正在读取 LuCI Release 清单"
	if ! fetch_manifest "$DNSQUALIFY_MANIFEST_URL" "$manifest"; then
		rm -rf "$tmpdir"
		fail "dnsqualify_manifest_download_failed" "无法下载 dnsqualify Release 清单。"
		return 1
	fi
	manifest_schema="$(jsonfilter -i "$manifest" -e '@.schema_version' 2>/dev/null)"
	asset_os="$(jsonfilter -i "$manifest" -e "@.assets[@.arch=\"$arch\"].os" 2>/dev/null)"
	asset_url="$(jsonfilter -i "$manifest" -e "@.assets[@.arch=\"$arch\"].url" 2>/dev/null)"
	asset_sha="$(jsonfilter -i "$manifest" -e "@.assets[@.arch=\"$arch\"].sha256" 2>/dev/null)"
	asset_version="$(jsonfilter -i "$manifest" -e '@.version' 2>/dev/null)"
	if [ "$manifest_schema" != "1" ]; then
		rm -rf "$tmpdir"
		fail_with_details "dnsqualify_manifest_schema_unsupported" "dnsqualify Release 清单 schema 不受支持。" '"schema_version":"'"$(json_escape "$manifest_schema")"'"'
		return 1
	fi
	if [ "$asset_os" != "linux" ] || [ -z "$asset_url" ] ||
		[ -z "$asset_sha" ] || [ -z "$asset_version" ]; then
		rm -rf "$tmpdir"
		fail "dnsqualify_manifest_asset_missing" "dnsqualify Release 清单中没有匹配此路由器的完整资产。"
		return 1
	fi
	case "$asset_version" in
		v[0-9]*.[0-9]*.[0-9]*-[0-9]*) ;;
		*)
			rm -rf "$tmpdir"
			fail "dnsqualify_manifest_version_invalid" "dnsqualify Release 清单版本格式无效。"
			return 1
			;;
	esac
	case "$asset_url" in
		"https://github.com/qoli/localclash-luci/releases/download/$asset_version/dnsqualify-linux-$arch") ;;
		*)
			rm -rf "$tmpdir"
			fail "dnsqualify_manifest_url_invalid" "dnsqualify Release 清单资产来源无效。"
			return 1
			;;
	esac
	case "$asset_sha" in
		*[!0-9a-f]*|"")
			rm -rf "$tmpdir"
			fail "dnsqualify_manifest_checksum_invalid" "dnsqualify Release 清单 sha256 格式无效。"
			return 1
			;;
	esac
	if [ "${#asset_sha}" -ne 64 ]; then
		rm -rf "$tmpdir"
		fail "dnsqualify_manifest_checksum_invalid" "dnsqualify Release 清单 sha256 长度无效。"
		return 1
	fi
	current_sha=""
	if [ -x "$DNSQUALIFY" ]; then
		current_sha="$(sha256sum "$DNSQUALIFY" 2>/dev/null | awk '{print $1; exit}')"
		if [ -z "$current_sha" ]; then
			rm -rf "$tmpdir"
			fail "dnsqualify_installed_checksum_failed" "无法计算已安装 dnsqualify 的 sha256。"
			return 1
		fi
	fi
	if [ -n "$current_sha" ] && [ "$current_sha" = "$asset_sha" ]; then
		rm -rf "$tmpdir"
		ok '"changed":false,"summary":"dnsqualify 已是当前 LuCI Release 版本。","dnsqualify":{"installed":true,"path":"'"$(json_escape "$DNSQUALIFY")"'","version":"'"$(json_escape "$asset_version")"'","arch":"'"$(json_escape "$arch")"'","sha256":"'"$(json_escape "$current_sha")"'"}}'
		return 0
	fi
	log_line "dnsqualify：正在下载 ${asset_version}（${arch}）"
	if ! fetch_url_verified "$asset_url" "$binary" "$asset_sha"; then
		rm -rf "$tmpdir"
		fail_with_details "dnsqualify_download_failed" "dnsqualify 下载失败或 sha256 校验不通过。" '"version":"'"$(json_escape "$asset_version")"'","arch":"'"$(json_escape "$arch")"'","expected_sha":"'"$(json_escape "$asset_sha")"'"'
		return 1
	fi
	chmod 755 "$binary"
	reported_version="$("$binary" --version 2>/dev/null || true)"
	if [ "$reported_version" != "dnsqualify $asset_version" ]; then
		rm -rf "$tmpdir"
		fail_with_details "dnsqualify_version_mismatch" "dnsqualify 二进制版本与 Release 清单不一致。" '"expected":"'"$(json_escape "$asset_version")"'","reported":"'"$(json_escape "$reported_version")"'"'
		return 1
	fi
	install_dir="$(dirname "$DNSQUALIFY")"
	if ! mkdir -p "$install_dir"; then
		rm -rf "$tmpdir"
		fail "dnsqualify_install_failed" "无法创建 dnsqualify 安装目录。"
		return 1
	fi
	tmp_binary="$DNSQUALIFY.tmp.$$"
	if ! cp "$binary" "$tmp_binary" || ! chmod 755 "$tmp_binary" || ! mv "$tmp_binary" "$DNSQUALIFY"; then
		rm -f "$tmp_binary"
		rm -rf "$tmpdir"
		fail "dnsqualify_install_failed" "无法原子安装 dnsqualify 二进制文件。"
		return 1
	fi
	rm -rf "$tmpdir"
	log_line "dnsqualify：已安装 ${asset_version}（${arch}）"
	ok '"changed":true,"summary":"dnsqualify 已安装。","dnsqualify":{"installed":true,"path":"'"$(json_escape "$DNSQUALIFY")"'","version":"'"$(json_escape "$asset_version")"'","arch":"'"$(json_escape "$arch")"'","sha256":"'"$(json_escape "$asset_sha")"'"}}'
}

dnsqualify_ensure() {
	local installed_version
	if [ -x "$DNSQUALIFY" ]; then
		installed_version="$(dnsqualify_installed_version 2>/dev/null || true)"
		if [ -n "$installed_version" ]; then
			ok '"changed":false,"summary":"dnsqualify 已安装。","dnsqualify":{"installed":true,"path":"'"$(json_escape "$DNSQUALIFY")"'","version":"'"$(json_escape "$installed_version")"'"}}'
			return 0
		fi
	fi
	dnsqualify_install
}

dnsqualify_status() {
	local config report version scope_id candidate source transport endpoint ecs_prefix ecs_source ecs_interface ecs_server ecs_server_ip ecs_country_code ecs_country_json generated installed binary_version
	config="$(dnsqualify_config_path)" || return 1
	report="$(dnsqualify_report_path)" || return 1
	installed=false
	binary_version=""
	if [ -x "$DNSQUALIFY" ]; then
		installed=true
		binary_version="$(dnsqualify_installed_version 2>/dev/null || true)"
	fi
	if [ ! -f "$config" ]; then
		ok '"status":{"enabled":false,"mode":"secure_baseline","scope":"default"},"binary_installed":'"$installed"',"binary_version":"'"$(json_escape "$binary_version")"'"'
		return 0
	fi
	version="$(jsonfilter -i "$config" -e '@.version' 2>/dev/null || true)"
	if [ "$version" != "2" ]; then
		fail "dnsqualify_config_invalid" "dnsqualify overlay 存在但契约不完整；Core 渲染也会明确拒绝。"
		return 1
	fi
	scope_id=""
	candidate=""
	source=""
	transport=""
	endpoint=""
	ecs_prefix=""
	ecs_source=""
	ecs_interface=""
	ecs_server=""
	ecs_server_ip=""
	ecs_country_code=""
	generated=""
	if [ -f "$report" ] && [ "$(jsonfilter -i "$report" -e '@.version' 2>/dev/null || true)" = "1" ]; then
		candidate="$(jsonfilter -i "$report" -e '@.selection.selected_id' 2>/dev/null || true)"
		if [ -n "$candidate" ]; then
			scope_id="$(jsonfilter -i "$report" -e '@.measurement.service_catalog.id' 2>/dev/null || true)"
			source="$(jsonfilter -i "$report" -e '@.selected.source' 2>/dev/null || true)"
			transport="$(jsonfilter -i "$report" -e '@.selected.transport' 2>/dev/null || true)"
			endpoint="$(jsonfilter -i "$report" -e '@.selected.endpoint' 2>/dev/null || true)"
			ecs_prefix="$(jsonfilter -i "$report" -e '@.selected.ecs_prefix' 2>/dev/null || true)"
			ecs_source="$(jsonfilter -i "$report" -e '@.selected.ecs_source' 2>/dev/null || true)"
			ecs_interface="$(jsonfilter -i "$report" -e '@.selected.ecs_interface' 2>/dev/null || true)"
			ecs_server="$(jsonfilter -i "$report" -e '@.selected.ecs_server' 2>/dev/null || true)"
			ecs_server_ip="$(jsonfilter -i "$report" -e '@.selected.ecs_server_ip' 2>/dev/null || true)"
			ecs_country_code="$(jsonfilter -i "$report" -e '@.selected.ecs_country_code' 2>/dev/null || true)"
			generated="$(jsonfilter -i "$report" -e '@.measurement.finished_at' 2>/dev/null || true)"
		fi
	fi
	ecs_country_json=""
	[ -z "$ecs_country_code" ] || ecs_country_json=',"country_code":"'"$(json_escape "$ecs_country_code")"'"'
	ok '"status":{"enabled":true,"mode":"qualified_ecs","scope":"'"$(json_escape "$scope_id")"'","resolver":{"candidate_id":"'"$(json_escape "$candidate")"'","source":"'"$(json_escape "$source")"'","transport":"'"$(json_escape "$transport")"'","endpoint":"'"$(json_escape "$endpoint")"'"},"ecs":{"prefix":"'"$(json_escape "$ecs_prefix")"'","source":"'"$(json_escape "$ecs_source")"'","interface":"'"$(json_escape "$ecs_interface")"'","server":"'"$(json_escape "$ecs_server")"'","server_ip":"'"$(json_escape "$ecs_server_ip")"'"'"$ecs_country_json"'},"generated_at":"'"$(json_escape "$generated")"'"},"binary_installed":'"$installed"',"binary_version":"'"$(json_escape "$binary_version")"'"'
}

dnsqualify_run() {
	local config report report_tmp backup had_config install_tmp result_tmp render_tmp test_tmp initial_ecs_interface
	config="$(dnsqualify_config_path)" || return 1
	report="$(dnsqualify_report_path)" || return 1
	report_tmp="${report}.tmp.$$"
	install_tmp="/tmp/localclash-dnsqualify-install-result.$$.json"
	if ! dnsqualify_ensure > "$install_tmp"; then
		cat "$install_tmp"
		rm -f "$install_tmp"
		return 1
	fi
	mkdir -p "$(dirname "$config")" || {
		rm -f "$install_tmp"
		fail "dnsqualify_state_dir_failed" "无法建立 dnsqualify 配置目录。"
		return 1
	}
	backup="/tmp/localclash-dnsqualify-backup.$$.json"
	had_config=false
	if [ -f "$config" ]; then
		cp "$config" "$backup" || return 1
		had_config=true
	fi
	result_tmp="/tmp/localclash-dnsqualify-result.$$.json"
	render_tmp="/tmp/localclash-dns-render.$$.json"
	test_tmp="/tmp/localclash-dns-test.$$.json"
	log_line "dnsqualify：用户按需启动独立 DNS 测试与配置生成"
	if ! dnsqualify_wan_ecs; then
		rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
		return 1
	fi
	initial_ecs_interface="$DNSQUALIFY_ECS_INTERFACE"
	if ! "$DNSQUALIFY" --output "$config" \
		--report-output "$report_tmp" \
		--ecs-interface "$DNSQUALIFY_ECS_INTERFACE" \
		--ecs-doh-proxy "$DNSQUALIFY_ECS_DOH_PROXY" \
		--json > "$result_tmp" 2>>"$LOG"; then
		rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
		fail "dnsqualify_run_failed" "独立 dnsqualify 测试失败；现有配置保持不变。"
		return 1
	fi
	if ! dnsqualify_wan_ecs || [ "$DNSQUALIFY_ECS_INTERFACE" != "$initial_ecs_interface" ]; then
		if ! dnsqualify_restore "$backup" "$had_config" "$config"; then
			rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
			fail "dnsqualify_rollback_failed" "WAN ECS 来源变化，且无法确认旧配置已恢复；请勿重启 Mihomo。"
			return 1
		fi
		rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
		fail "dnsqualify_wan_changed" "测量期间 WAN 公网地址或接口发生变化；已恢复原配置，请重新运行。"
		return 1
	fi
	if ! call_core config render --json > "$render_tmp" ||
		! call_core mihomo config-test --json > "$test_tmp"; then
		if ! dnsqualify_restore "$backup" "$had_config" "$config"; then
			rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
			fail "dnsqualify_rollback_failed" "dnsqualify 配置验证失败，且无法确认旧配置已恢复；请勿重启 Mihomo。"
			return 1
		fi
		rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
		fail "dnsqualify_validation_failed" "dnsqualify 输出未通过 Core 渲染或 Mihomo 验证，已恢复原配置。"
		return 1
	fi
	if ! mv "$report_tmp" "$report"; then
		if ! dnsqualify_restore "$backup" "$had_config" "$config"; then
			rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
			fail "dnsqualify_rollback_failed" "dnsqualify 报告发布失败，且无法确认旧配置已恢复；请勿重启 Mihomo。"
			return 1
		fi
		rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp" "$report_tmp"
		fail "dnsqualify_report_publish_failed" "dnsqualify 报告发布失败，已恢复原配置。"
		return 1
	fi
	ok '"changed":true,"restart_required":true,"summary":"独立 dnsqualify 已生成并验证配置；请重启 Mihomo 后生效。","install":'"$(cat "$install_tmp")"',"dnsqualify":'"$(cat "$result_tmp")"',"render":'"$(cat "$render_tmp")"',"config_test":'"$(cat "$test_tmp")"
	rm -f "$backup" "$install_tmp" "$result_tmp" "$render_tmp" "$test_tmp"
}

dnsqualify_restore() {
	local backup had_config config
	backup="$1"
	had_config="$2"
	config="$3"
	if [ "$had_config" = "true" ]; then
		cp "$backup" "$config" || return 1
	else
		rm -f "$config" || return 1
	fi
	if ! call_core config render --json >/tmp/localclash-dns-rollback-render.$$.json 2>>"$LOG" ||
		! call_core mihomo config-test --json >/tmp/localclash-dns-rollback-test.$$.json 2>>"$LOG"; then
		rm -f /tmp/localclash-dns-rollback-render.$$.json /tmp/localclash-dns-rollback-test.$$.json
		return 1
	fi
	rm -f /tmp/localclash-dns-rollback-render.$$.json /tmp/localclash-dns-rollback-test.$$.json
}

dnsqualify_reset_run() {
	local config report backup render_tmp test_tmp
	config="$(dnsqualify_config_path)" || return 1
	report="$(dnsqualify_report_path)" || return 1
	[ -f "$config" ] || {
		ok '"changed":false,"summary":"DNS 最佳化本来就是关闭状态。"'
		return 0
	}
	backup="/tmp/localclash-dnsqualify-backup.$$.json"
	cp "$config" "$backup" || return 1
	render_tmp="/tmp/localclash-dns-render.$$.json"
	test_tmp="/tmp/localclash-dns-test.$$.json"
	if ! rm -f "$config" ||
		! call_core config render --json > "$render_tmp" ||
		! call_core mihomo config-test --json > "$test_tmp"; then
		if ! dnsqualify_restore "$backup" true "$config"; then
			rm -f "$backup" "$render_tmp" "$test_tmp"
			fail "dnsqualify_reset_rollback_failed" "删除 dnsqualify 配置失败，且无法确认原配置已恢复；请勿重启 Mihomo。"
			return 1
		fi
		rm -f "$backup" "$render_tmp" "$test_tmp"
		fail "dnsqualify_reset_failed" "无法安全删除 dnsqualify 配置，已恢复变更前状态。"
		return 1
	fi
	rm -f "$report"
	ok '"changed":true,"restart_required":true,"summary":"已删除 dnsqualify 配置并恢复 Core 默认 DNS 选择；请重启 Mihomo 后生效。","render":'"$(cat "$render_tmp")"',"config_test":'"$(cat "$test_tmp")"
	rm -f "$backup" "$render_tmp" "$test_tmp"
}

start_dnsqualify_task() {
	local action summary result rc bg_pid
	action="$1"
	summary="$2"
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	printf '{"action":"%s"}\n' "$(json_escape "$action")" > "$TASK_INPUT"
	write_task_running "$summary" "dnsqualify"
	(
		result="$("$0" call dnsqualify_task_run 2>>"$LOG")"
		rc=$?
		[ -n "$result" ] || result='{"ok":false,"code":"empty_task_result","message":"DNS 任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_INPUT" "$TASK_PID"
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"DNS 任务已启动。"'
}

dnsqualify_task_run() {
	local action
	action="$(jsonfilter -i "$TASK_INPUT" -e '@.action' 2>/dev/null || true)"
	case "$action" in
		optimize) with_lock dnsqualify_run ;;
		reset) with_lock dnsqualify_reset_run ;;
		*) fail "dns_task_invalid" "DNS 任务类型无效。"; return 1 ;;
	esac
}

reset() {
	local takeover_tmp rc
	if runtime_running; then
		fail "runtime_running" "Mihomo 运行时正在运行，请先停止运行时再执行完整重置。"
		return 1
	fi
	takeover_tmp="/tmp/localclash-takeover-stop-before-reset.$$.json"
	call_takeover stop --json > "$takeover_tmp"
	rc=$?
	if [ "$rc" -ne 0 ]; then
		cat "$takeover_tmp" 2>/dev/null || true
		rm -f "$takeover_tmp"
		return "$rc"
	fi
	rm -f "$takeover_tmp"
	call_core reset --full --json
}

bootstrap_core() {
	local arch tmpdir manifest binary asset_url asset_sha asset_version tmp_core service_result
	log_line "核心初始化：开始"
	if ! command -v jsonfilter >/dev/null 2>&1; then
		log_line "核心初始化：缺少 jsonfilter"
		fail "jsonfilter_missing" "需要 jsonfilter 解析 localClash Release 清单。"
		return 1
	fi
	arch="$(router_arch)" || {
		log_line "核心初始化：不支持的架构 $(uname -m)"
		fail "unsupported_arch" "localClash 初始化助手不支持此路由器架构。"
		return 1
	}
	tmpdir="$(mktemp -d /tmp/localclash-bootstrap.XXXXXX)" || {
		fail "tmpdir_failed" "无法创建临时初始化目录。"
		return 1
	}
	manifest="$tmpdir/manifest.json"
	binary="$tmpdir/localclash"
	log_line "核心初始化：正在下载 Release 清单"
	if ! fetch_manifest "$MANIFEST_URL" "$manifest"; then
		rm -rf "$tmpdir"
		log_line "核心初始化：Release 清单下载失败"
		fail "manifest_download_failed" "无法下载 localClash Release 清单。"
		return 1
	fi
	asset_url="$(jsonfilter -i "$manifest" -e "@.assets[@.arch=\"$arch\"].url" 2>/dev/null)"
	asset_sha="$(jsonfilter -i "$manifest" -e "@.assets[@.arch=\"$arch\"].sha256" 2>/dev/null)"
	asset_version="$(jsonfilter -i "$manifest" -e "@.version" 2>/dev/null)"
	if [ -z "$asset_url" ] || [ -z "$asset_sha" ]; then
		rm -rf "$tmpdir"
		log_line "核心初始化：Release 清单中没有 $arch 可用文件"
		fail "manifest_asset_missing" "Release 清单中没有匹配此路由器的 Linux 二进制文件。"
		return 1
	fi
	log_line "核心初始化：正在下载 localClash 核心 ${asset_version}（${arch}）"
	if ! fetch_url_verified "$asset_url" "$binary" "$asset_sha"; then
		rm -rf "$tmpdir"
		log_line "核心初始化：核心下载失败"
		fail "core_download_failed" "无法下载 localClash 核心二进制文件。"
		return 1
	fi
	log_line "核心初始化：sha256 校验通过"
	chmod 755 "$binary"
	mkdir -p "$(dirname "$CORE")"
	tmp_core="$CORE.tmp.$$"
	log_line "核心初始化：正在安装 localClash 核心"
	if ! cp "$binary" "$tmp_core" || ! chmod 755 "$tmp_core" || ! mv "$tmp_core" "$CORE"; then
		rm -f "$tmp_core"
		rm -rf "$tmpdir"
		log_line "核心初始化：核心安装失败"
		fail "core_install_failed" "无法安装 localClash 核心二进制文件。"
		return 1
	fi
	service_result="$(service_start)" || {
		rm -rf "$tmpdir"
		log_line "核心初始化：MCP 服务启动失败"
		if [ -n "$service_result" ]; then
			printf '%s\n' "$service_result"
		else
			fail "service_start_failed" "localClash 核心已安装，但 MCP 服务无法启动。"
		fi
		return 1
	}
	if ! install_base_assets "$manifest" "$tmpdir"; then
		rm -rf "$tmpdir"
		return 1
	fi
	rm -rf "$tmpdir"
	log_line "已安装 localClash 核心 ${asset_version}（${arch}）"
	ok "\"changed\":true,\"summary\":\"localClash 核心已安装。\",\"core\":{\"installed\":true,\"path\":\"$CORE\",\"version\":\"$(json_escape "$asset_version")\",\"arch\":\"$arch\"}"
}

install_base_assets() {
	local output
	output="/tmp/localclash-base-assets.$$.json"
	if ! core_installed; then
		fail "bootstrap_core_missing" "localClash 核心尚未安装，无法初始化基础文件。"
		return 1
	fi
	mkdir -p "$STATE_DIR"
	log_line "基础文件初始化：交由 localClash 核心安装基础文件"
	if ! call_core component update assets --json > "$output"; then
		log_line "基础文件初始化：核心安装基础文件失败"
		cat "$output"
		rm -f "$output"
		return 1
	fi
	log_line "基础文件初始化：已由 localClash 核心安装"
	rm -f "$output"
	return 0
}

bootstrap_assets() {
	log_line "基础文件初始化：开始"
	if ! install_base_assets "" ""; then
		return 1
	fi
	ok "\"changed\":true,\"summary\":\"localClash 基础文件已安装。\",\"base_assets\":{\"installed\":true,\"path\":\"$(json_escape "$STATE_DIR")\"}"
}

bootstrap_logs() {
	if [ -f "$LOG" ]; then
		awk '
			BEGIN { printf "{\"ok\":true,\"complete\":true,\"logs\":[" }
			{
				gsub(/\\/, "\\\\")
				gsub(/"/, "\\\"")
				gsub(/\t/, "\\t")
				gsub(/\r/, "\\r")
				printf "%s\"%s\"", sep, $0
				sep=","
				count++
			}
			END { printf "],\"line_count\":%d}\n", count }
		' "$LOG"
	else
		printf '{"ok":true,"complete":true,"logs":[],"line_count":0}\n'
	fi
}

bootstrap_task_status() {
	reconcile_task_status
	if [ -f "$TASK_STATUS" ]; then
		cat "$TASK_STATUS"
	else
		printf '{"ok":true,"running":false,"done":false,"result":null}\n'
	fi
}

task_status() {
	bootstrap_task_status
}

start_bootstrap_default() {
	local payload result rc bg_pid
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	payload="$(strip_ubus_rpc_session "$(cat)")"
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	write_versioned_payload "$payload" > "$TASK_INPUT"
	write_task_running "初始化和运行时启动任务正在运行。" "bootstrap_default"
	log_line "默认初始化：已加入后台任务队列"
	(
		result="$("$0" call bootstrap_default_run 2>>"$LOG")"
		rc=$?
		if [ -z "$result" ]; then
			result='{"ok":false,"code":"empty_task_result","message":"初始化任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		fi
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_INPUT" "$TASK_PID"
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"初始化和运行时启动任务已启动。"'
}

bootstrap_default_run() {
	local tmpdir mihomo_attempt payload selected_core selected_template subscription_input subscription_changed subscription_ready runtime_started runtime_result service_result
	payload='{"version":1}'
	selected_core="meta"
	selected_template="localclash-default"
	subscription_changed=false
	subscription_ready=false
	runtime_started=false

	if [ -f "$TASK_INPUT" ]; then
		payload="$(cat "$TASK_INPUT" 2>/dev/null || printf '{"version":1}')"
	fi
	selected_core="$(jsonfilter -s "$payload" -e '@.core' 2>/dev/null || true)"
	selected_template="$(jsonfilter -s "$payload" -e '@.template' 2>/dev/null || true)"
	[ -n "$selected_core" ] || selected_core="meta"
	[ -n "$selected_template" ] || selected_template="localclash-default"
	case "$selected_core" in
		meta|smart) ;;
		*)
			fail "invalid_bootstrap_core" "初始化核心类型必须是 meta 或 smart。"
			return 1
			;;
	esac
	case "$selected_template" in
		minimal|localclash-default) ;;
		*)
			fail "invalid_bootstrap_template" "初始化配置模板必须是 minimal 或 localclash-default。"
			return 1
			;;
	esac

	log_line "默认初始化：开始路由器默认设置"
	tmpdir="$(mktemp -d /tmp/localclash-default.XXXXXX)" || {
		log_line "默认初始化：临时目录创建失败"
		fail "tmpdir_failed" "无法创建临时默认设置目录。"
		return 1
	}

	log_line "默认初始化：第一步更新 localClash 核心"
	if ! bootstrap_core > "$tmpdir/core.json"; then
		cat "$tmpdir/core.json"
		rm -rf "$tmpdir"
		return 1
	fi

	if ! base_assets_installed; then
		log_line "默认初始化：基础文件缺失，开始初始化：$(base_assets_missing_reason)"
		if ! bootstrap_assets > "$tmpdir/assets.json"; then
			cat "$tmpdir/assets.json"
			rm -rf "$tmpdir"
			return 1
		fi
	else
		log_line "默认初始化：基础文件已安装"
	fi

	subscription_input="$tmpdir/subscription.json"
	if write_bootstrap_subscription_input "$payload" "$subscription_input"; then
		log_line "默认初始化：正在保存并刷新订阅"
		if ! subscription_save_refresh_file "$subscription_input" "$tmpdir"; then
			rm -rf "$tmpdir"
			return 1
		fi
		subscription_changed=true
	else
		rm -f "$subscription_input"
		log_line "默认初始化：未收到新的订阅输入"
	fi

	if mihomo_core_installed; then
		log_line "默认初始化：Mihomo 核心已安装，跳过更新"
	else
		log_line "默认初始化：正在更新 Mihomo 核心"
		mihomo_attempt=1
		while ! run_with_heartbeat "默认初始化：正在更新 Mihomo 核心" "$tmpdir/mihomo.json" call_core component update mihomo --json; do
			if [ "$mihomo_attempt" -ge 3 ]; then
				log_line "默认初始化：Mihomo 核心更新失败，已尝试 $mihomo_attempt 次"
				cat "$tmpdir/mihomo.json"
				rm -rf "$tmpdir"
				return 1
			fi
			mihomo_attempt=$((mihomo_attempt + 1))
			log_line "默认初始化：Mihomo 核心更新失败，正在进行第 $mihomo_attempt 次重试"
			sleep 2
		done
	fi

	if dashboard_installed; then
		log_line "默认初始化：Dashboard 面板文件已安装，跳过更新"
	else
		log_line "默认初始化：正在更新 Dashboard 面板文件"
		if ! run_with_heartbeat "默认初始化：正在更新 Dashboard 面板文件" "$tmpdir/dashboard.json" call_core component update dashboard --json; then
			log_line "默认初始化：Dashboard 面板更新失败"
			cat "$tmpdir/dashboard.json"
			rm -rf "$tmpdir"
			return 1
		fi
	fi

	cat > "$tmpdir/template.json" <<JSON
{
  "version": 1,
  "template": "$selected_template",
  "runtime_profile": "router",
  "core": "$selected_core",
  "allow_overwrite_modified": false
}
JSON

	log_line "默认初始化：正在应用 router/$selected_core/$selected_template 默认配置"
	if ! call_core config apply-template --input "$tmpdir/template.json" --json > "$tmpdir/template-result.json"; then
		log_line "默认初始化：默认配置应用失败"
		cat "$tmpdir/template-result.json"
		rm -rf "$tmpdir"
		return 1
	fi

	if [ "$subscription_changed" = true ] || subscription_configured; then
		subscription_ready=true
		log_line "默认初始化：正在生成 Mihomo 配置"
		if ! run_with_heartbeat "默认初始化：正在生成 Mihomo 配置" "$tmpdir/render.json" call_core config render --json; then
			log_line "默认初始化：配置生成失败"
			cat "$tmpdir/render.json"
			rm -rf "$tmpdir"
			return 1
		fi
	else
		log_line "默认初始化：订阅尚未配置，跳过配置生成"
	fi

	service_result="$(service_start)" || {
		rm -rf "$tmpdir"
		log_line "默认初始化：MCP 服务启动失败"
		if [ -n "$service_result" ]; then
			printf '%s\n' "$service_result"
		else
			fail "service_start_failed" "默认配置已应用，但 MCP 服务无法启动。"
		fi
		return 1
	}

	if [ "$subscription_ready" = true ]; then
		log_line "默认初始化：正在启动运行时并应用网络接管"
		if ! runtime_start_takeover_run bootstrap_default > "$tmpdir/runtime-start.json"; then
			log_line "默认初始化：运行时启动和网络接管失败"
			cat "$tmpdir/runtime-start.json"
			rm -rf "$tmpdir"
			return 1
		fi
		runtime_started=true
		runtime_result="$(cat "$tmpdir/runtime-start.json")"
	fi

	rm -rf "$tmpdir"
	log_line "默认初始化：已完成路由器默认设置"
	if [ "$runtime_started" = true ]; then
		printf '{"ok":true,"changed":true,"summary":"已应用路由器默认设置，运行时已启动。","subscription_changed":%s,"profile":{"runtime_profile":"router","core":"%s","template":"%s"},"runtime_start":%s}\n' "$subscription_changed" "$selected_core" "$selected_template" "$runtime_result"
	else
		ok '"changed":true,"summary":"已应用路由器默认设置。","subscription_changed":'"$subscription_changed"',"profile":{"runtime_profile":"router","core":"'"$selected_core"'","template":"'"$selected_template"'"}'
	fi
}

start_runtime_takeover() {
	local result rc bg_pid
	clear_stale_lock
	if [ -d "$LOCK_DIR" ]; then
		printf '{"ok":true,"started":false,"running":true,"summary":"另一个 localClash 任务正在运行。"}\n'
		return 0
	fi
	rm -f "$TASK_STATUS" "$TASK_RESULT" "$TASK_INPUT" "$TASK_PID"
	: > "$LOG"
	write_task_running "运行时启动和网络接管任务正在运行。" "runtime_start_takeover"
	log_line "运行时接管：已加入后台任务队列"
	(
		result="$("$0" call runtime_start_takeover_run 2>>"$LOG")"
		rc=$?
		if [ -z "$result" ]; then
			result='{"ok":false,"code":"empty_task_result","message":"运行时启动和网络接管任务没有产生 JSON 结果。","details":{},"next_actions":[]}'
		fi
		printf '%s\n' "$result" > "$TASK_RESULT"
		write_task_done "$rc" "$result"
		rm -f "$TASK_PID"
	) >/dev/null 2>&1 &
	bg_pid="$!"
	write_task_pid "$bg_pid"
	ok '"started":true,"running":true,"summary":"运行时启动和网络接管任务已启动。"'
}

runtime_start_takeover_run() {
	local tmpdir rc source error_fields error_code error_message
	source="${1:-runtime_start_takeover}"
	takeover_event_scope
	takeover_log_event_safe "$source" "runtime_takeover_started"
	log_line "运行时接管：开始"
	tmpdir="$(mktemp -d /tmp/localclash-runtime.XXXXXX)" || {
		log_line "运行时接管：临时目录创建失败"
		takeover_log_event_safe "$source" "runtime_takeover_finished" "result" "failure" "stage" "create_tmpdir"
		fail "tmpdir_failed" "无法创建临时 runtime 任务目录。"
		return 1
	}

	log_line "运行时接管：正在启动运行时"
	if ! run_with_heartbeat "运行时接管：正在启动运行时" "$tmpdir/runtime.json" call_core runtime start --json; then
		log_line "运行时接管：运行时启动失败"
		takeover_log_event_safe "$source" "runtime_takeover_finished" "result" "failure" "stage" "runtime_start"
		cat "$tmpdir/runtime.json"
		rm -rf "$tmpdir"
		return 1
	fi
	sleep 2
	if ! runtime_running; then
		log_line "运行时接管：运行时启动命令已返回成功，但进程没有保持运行"
		takeover_log_event_safe "$source" "runtime_takeover_finished" "result" "failure" "stage" "runtime_liveness"
		fail "runtime_not_running_after_start" "运行时启动命令已返回，但进程没有保持运行。请查看运行日志；常见原因是端口被 OpenClash 或其他服务占用。"
		rm -rf "$tmpdir"
		return 1
	fi

	if takeover_skip_enabled; then
		log_line "运行时接管：测试模式已启用，跳过网络接管"
		takeover_log_event_safe "$source" "runtime_takeover_finished" "result" "skipped" "reason" "test_mode"
		printf '{"ok":true,"changed":true,"summary":"运行时已启动；测试模式已跳过网络接管。","runtime":%s,"takeover":{"ok":true,"changed":false,"skipped":true,"summary":"测试模式已跳过网络接管。"}}\n' "$(cat "$tmpdir/runtime.json")"
		rm -rf "$tmpdir"
		return 0
	fi

	log_line "运行时接管：正在应用网络接管"
	run_with_heartbeat "运行时接管：正在应用网络接管" "$tmpdir/takeover.json" call_takeover apply --json
	rc=$?
	if [ "$rc" -ne 0 ]; then
		log_line "运行时接管：网络接管应用失败"
		error_fields="$(takeover_error_log_fields "$tmpdir/takeover.json")"
		error_code="$(printf '%s\n' "$error_fields" | sed -n '1p')"
		error_message="$(printf '%s\n' "$error_fields" | sed -n '2p')"
		takeover_log_event_safe "$source" "runtime_takeover_finished" "result" "failure" "stage" "takeover_apply" "exit_code" "$rc" "core_code" "$error_code" "message" "$error_message"
		log_line "运行时接管：正在撤销可能残留的网络接管"
		if call_takeover stop --json > "$tmpdir/takeover-stop.json"; then
			log_line "运行时接管：网络接管撤销完成"
		else
			log_line "运行时接管：网络接管撤销也失败"
		fi
		log_line "运行时接管：网络接管失败后正在停止运行时"
		runtime_stop > "$tmpdir/runtime-stop.json" 2>/dev/null || log_line "运行时接管：失败后停止运行时也失败"
		cat "$tmpdir/takeover.json"
		rm -rf "$tmpdir"
		return 1
	fi

	log_line "运行时接管：已完成"
	takeover_log_event_safe "$source" "runtime_takeover_finished" "result" "success" "exit_code" "$rc"
	printf '{"ok":true,"changed":true,"summary":"运行时已启动，网络接管已应用。","runtime":%s,"takeover":%s}\n' "$(cat "$tmpdir/runtime.json")" "$(cat "$tmpdir/takeover.json")"
	rm -rf "$tmpdir"
}

takeover_apply() {
	local tmp rc source fields effective runtime_running profile_mode error_fields error_code error_message
	source="${1:-manual_apply}"
	takeover_event_scope
	takeover_log_event_safe "$source" "apply_started"
	if takeover_skip_enabled; then
		takeover_log_event_safe "$source" "apply_blocked" "reason" "test_mode"
		fail "takeover_skipped_for_test" "测试模式已启用，已阻止网络接管。删除 /tmp/localclash-skip-takeover 后才允许应用网络接管。"
		return 1
	fi

	tmp="/tmp/localclash-takeover-apply.$$.json"
	call_takeover apply --json > "$tmp"
	rc=$?
	if [ "$rc" -eq 0 ]; then
		fields="$(takeover_status_log_fields "$tmp")"
		effective="$(printf '%s\n' "$fields" | sed -n '1p')"
		runtime_running="$(printf '%s\n' "$fields" | sed -n '2p')"
		profile_mode="$(printf '%s\n' "$fields" | sed -n '3p')"
		takeover_log_event_safe "$source" "apply_finished" "result" "success" "exit_code" "$rc" "effective" "$effective" "runtime_running" "$runtime_running" "profile_mode" "$profile_mode"
		cat "$tmp"
		rm -f "$tmp"
		return 0
	fi
	error_fields="$(takeover_error_log_fields "$tmp")"
	error_code="$(printf '%s\n' "$error_fields" | sed -n '1p')"
	error_message="$(printf '%s\n' "$error_fields" | sed -n '2p')"
	takeover_log_event_safe "$source" "apply_finished" "result" "failure" "exit_code" "$rc" "core_code" "$error_code" "message" "$error_message"
	cat "$tmp" 2>/dev/null || true
	rm -f "$tmp"
	return "$rc"
}

takeover_stop() {
	local tmp rc source error_fields error_code error_message
	source="${1:-manual_stop}"
	takeover_event_scope
	takeover_log_event_safe "$source" "stop_started"
	tmp="/tmp/localclash-takeover-stop.$$.json"
	call_takeover stop --json > "$tmp"
	rc=$?
	if [ "$rc" -eq 0 ]; then
		takeover_log_event_safe "$source" "stop_finished" "result" "success" "exit_code" "$rc"
		cat "$tmp"
		rm -f "$tmp"
		return 0
	fi
	error_fields="$(takeover_error_log_fields "$tmp")"
	error_code="$(printf '%s\n' "$error_fields" | sed -n '1p')"
	error_message="$(printf '%s\n' "$error_fields" | sed -n '2p')"
	takeover_log_event_safe "$source" "stop_finished" "result" "failure" "exit_code" "$rc" "core_code" "$error_code" "message" "$error_message"
	cat "$tmp" 2>/dev/null || true
	rm -f "$tmp"
	return "$rc"
}

takeover_restore_run() {
	local tmpdir effective runtime_running profile_mode rc source error_fields error_code error_message
	source="${LOCALCLASH_TAKEOVER_RESTORE_SOURCE:-same_boot_repair}"
	takeover_event_scope
	takeover_log_event_safe "$source" "restore_started"
	if takeover_skip_enabled; then
		log_line "网络接管恢复：测试模式已启用，跳过"
		takeover_log_event_safe "$source" "restore_skipped" "reason" "test_mode"
		ok '"changed":false,"skipped":true,"summary":"测试模式已启用，跳过网络接管恢复。"'
		return 0
	fi
	if ! takeover_restore_requested; then
		log_line "网络接管恢复：没有本次开机修复票据，跳过"
		takeover_log_event_safe "$source" "restore_skipped" "reason" "repair_ticket_missing"
		ok '"changed":false,"skipped":true,"summary":"没有本次开机网络接管修复票据，跳过恢复。"'
		return 0
	fi

	tmpdir="$(mktemp -d /tmp/localclash-restore.XXXXXX)" || {
		fail "tmpdir_failed" "无法创建网络接管恢复临时目录。"
		return 1
	}

	log_line "网络接管恢复：检查当前状态"
	if call_takeover status --json > "$tmpdir/status.json"; then
		rc=0
	else
		rc=$?
		log_line "网络接管恢复：状态检查失败"
		error_fields="$(takeover_error_log_fields "$tmpdir/status.json")"
		error_code="$(printf '%s\n' "$error_fields" | sed -n '1p')"
		error_message="$(printf '%s\n' "$error_fields" | sed -n '2p')"
		takeover_log_event_safe "$source" "status_failed" "exit_code" "$rc" "core_code" "$error_code" "message" "$error_message"
		cat "$tmpdir/status.json" 2>/dev/null || true
		rm -rf "$tmpdir"
		return "$rc"
	fi

	effective="$(jsonfilter -i "$tmpdir/status.json" -e '@.status.effective' 2>/dev/null || true)"
	runtime_running="$(jsonfilter -i "$tmpdir/status.json" -e '@.status.runtime_running' 2>/dev/null || true)"
	profile_mode="$(jsonfilter -i "$tmpdir/status.json" -e '@.status.profile_mode' 2>/dev/null || true)"
	takeover_log_event_safe "$source" "status_observed" "effective" "${effective:-unknown}" "runtime_running" "${runtime_running:-unknown}" "profile_mode" "${profile_mode:-unknown}"

	if [ "$effective" = "true" ]; then
		log_line "网络接管恢复：当前已生效"
		call_takeover reconcile --desired enabled --json > "$tmpdir/reconcile.json"
		rc=$?
		if [ "$rc" -ne 0 ]; then
			log_line "网络接管恢复：当前规则有效，但修复状态协调失败"
			cat "$tmpdir/reconcile.json" 2>/dev/null || true
			rm -rf "$tmpdir"
			return "$rc"
		fi
		takeover_log_event_safe "$source" "restore_finished" "result" "already_effective"
		cat "$tmpdir/reconcile.json"
		rm -rf "$tmpdir"
		return 0
	fi

	if [ "$profile_mode" != "router" ]; then
		log_line "网络接管恢复：当前不是 router profile，跳过"
		takeover_log_event_safe "$source" "restore_skipped" "reason" "profile_not_router" "profile_mode" "${profile_mode:-unknown}"
		printf '{"ok":true,"changed":false,"skipped":true,"summary":"当前不是 router profile，跳过网络接管恢复。","status":%s}\n' "$(cat "$tmpdir/status.json")"
		rm -rf "$tmpdir"
		return 0
	fi

	if [ "$runtime_running" = "true" ]; then
		log_line "网络接管恢复：运行时已运行，重新应用接管"
		takeover_log_event_safe "$source" "repair_apply_started"
		if call_takeover apply --json > "$tmpdir/apply.json"; then
			rc=0
		else
			rc=$?
			log_line "网络接管恢复：重新应用接管失败"
			error_fields="$(takeover_error_log_fields "$tmpdir/apply.json")"
			error_code="$(printf '%s\n' "$error_fields" | sed -n '1p')"
			error_message="$(printf '%s\n' "$error_fields" | sed -n '2p')"
			takeover_log_event_safe "$source" "repair_apply_finished" "result" "failure" "exit_code" "$rc" "core_code" "$error_code" "message" "$error_message"
			cat "$tmpdir/apply.json" 2>/dev/null || true
			rm -rf "$tmpdir"
			return "$rc"
		fi
		log_line "网络接管恢复：重新应用接管已验证生效"
		takeover_log_event_safe "$source" "repair_apply_finished" "result" "success" "exit_code" "$rc"
		printf '{"ok":true,"changed":true,"summary":"网络接管已重新应用。","status":%s,"takeover":%s}\n' "$(cat "$tmpdir/status.json")" "$(cat "$tmpdir/apply.json")"
		rm -rf "$tmpdir"
		return 0
	fi

	log_line "网络接管恢复：运行时未运行，本次开机修复不会启动运行时"
	takeover_log_event_safe "$source" "restore_skipped" "reason" "runtime_not_running"
	printf '{"ok":true,"changed":false,"skipped":true,"summary":"运行时未运行，本次开机修复不会启动运行时。","status":%s}\n' "$(cat "$tmpdir/status.json")"
	rm -rf "$tmpdir"
}

boot_restore_startup_allowed() {
	local max_uptime uptime
	max_uptime="$BOOT_RESTORE_MAX_UPTIME"
	case "$max_uptime" in
		""|*[!0-9]*) max_uptime=300 ;;
	esac
	[ "$max_uptime" -eq 0 ] && return 0
	uptime="$(cut -d. -f1 "$PROC_UPTIME" 2>/dev/null || printf '0')"
	case "$uptime" in
		""|*[!0-9]*) uptime=0 ;;
	esac
	[ "$uptime" -le "$max_uptime" ]
}

boot_restore_startup_run() {
	if ! boot_restore_startup_allowed; then
		log_line "开机自动恢复：当前不是开机窗口，跳过"
		ok '"changed":false,"skipped":true,"summary":"当前不是开机自动恢复窗口，跳过。",'"$(boot_restore_json)"
		return 0
	fi
	boot_restore_run
}

boot_restore_run() {
	if ! boot_auto_restore_enabled; then
		log_line "开机自动恢复：未启用，跳过"
		ok '"changed":false,"skipped":true,"summary":"开机自动恢复未启用。",'"$(boot_restore_json)"
		return 0
	fi
	if takeover_skip_enabled; then
		log_line "开机自动恢复：测试模式已启用，跳过"
		ok '"changed":false,"skipped":true,"summary":"测试模式已启用，跳过开机自动恢复。",'"$(boot_restore_json)"
		return 0
	fi
	log_line "开机自动恢复：开始"
	LOCALCLASH_TAKEOVER_EVENT_ID="boot:$$:$(now_epoch)" runtime_start_takeover_run boot_auto_restore
}

file_lines_json() {
	local path
	path="$1"
	if [ -f "$path" ]; then
		LC_ALL=C tr -d '\000-\010\013\014\016-\037\177' < "$path" | awk '
			BEGIN { printf "[" }
			{
				gsub(/\\/, "\\\\")
				gsub(/"/, "\\\"")
				gsub(/\t/, "\\t")
				gsub(/\r/, "\\r")
				printf "%s\"%s\"", sep, $0
				sep=","
			}
			END { printf "]" }
		'
	else
		printf '[]'
	fi
}

redact_diagnostic_stream() {
	awk '
		{
			gsub(/https?:\/\/[^[:space:]]+/, "<url>")
			gsub(/[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]/, "<mac>")
			gsub(/[0-9A-Fa-f][0-9A-Fa-f:]*::[0-9A-Fa-f:\/]*/, "<ipv6>")
			gsub(/[0-9A-Fa-f][0-9A-Fa-f]*:[0-9A-Fa-f][0-9A-Fa-f]*:[0-9A-Fa-f][0-9A-Fa-f]*:[0-9A-Fa-f:\/][0-9A-Fa-f:\/]*/, "<ipv6>")
			gsub(/[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?\.[0-9][0-9]?[0-9]?/, "<ipv4>")
			print
		}
	'
}

takeover_snapshot() {
	local output errors rc raw
	output="$1"
	errors="$2"
	: > "$output" || return 1
	: > "$errors" || return 1

	printf '[policy-rules-v4]\n' >> "$output"
	if command -v ip >/dev/null 2>&1; then
		if ip rule show >> "$output" 2>&1; then
			:
		else
			rc=$?
			printf 'ip rule show failed rc=%s\n' "$rc" >> "$output"
			printf 'policy_rules_v4_failed\n' >> "$errors"
		fi
	else
		printf 'ip unavailable\n' >> "$output"
		printf 'ip_unavailable\n' >> "$errors"
	fi

	printf '[route-table-%s-v4]\n' "$TAKEOVER_ROUTE_TABLE" >> "$output"
	if command -v ip >/dev/null 2>&1; then
		if ip route show table "$TAKEOVER_ROUTE_TABLE" >> "$output" 2>&1; then
			:
		else
			rc=$?
			printf 'ip route show failed rc=%s\n' "$rc" >> "$output"
			printf 'route_table_v4_failed\n' >> "$errors"
		fi
	else
		printf 'ip unavailable\n' >> "$output"
	fi

	printf '[policy-rules-v6]\n' >> "$output"
	if command -v ip >/dev/null 2>&1; then
		if ip -6 rule show >> "$output" 2>&1; then
			:
		else
			rc=$?
			printf 'ip -6 rule show failed rc=%s\n' "$rc" >> "$output"
			printf 'policy_rules_v6_failed\n' >> "$errors"
		fi
	else
		printf 'ip unavailable\n' >> "$output"
	fi

	printf '[route-table-%s-v6]\n' "$TAKEOVER_ROUTE_TABLE" >> "$output"
	if command -v ip >/dev/null 2>&1; then
		if ip -6 route show table "$TAKEOVER_ROUTE_TABLE" >> "$output" 2>&1; then
			:
		else
			rc=$?
			printf 'ip -6 route show failed rc=%s\n' "$rc" >> "$output"
			printf 'route_table_v6_failed\n' >> "$errors"
		fi
	else
		printf 'ip unavailable\n' >> "$output"
	fi

	printf '[tun-utun]\n' >> "$output"
	if command -v ip >/dev/null 2>&1; then
		if ip -details link show utun >> "$output" 2>&1; then
			:
		else
			rc=$?
			printf 'ip link show utun failed rc=%s\n' "$rc" >> "$output"
			printf 'tun_snapshot_failed\n' >> "$errors"
		fi
	else
		printf 'ip unavailable\n' >> "$output"
	fi

	printf '[fw4-localclash-rules]\n' >> "$output"
	if command -v nft >/dev/null 2>&1; then
		raw="${output}.nft"
		if nft -a list table inet fw4 > "$raw" 2>&1; then
			awk '/local[Cc]lash/ { print; found=1 } END { if (!found) print "no localClash rules observed" }' "$raw" >> "$output"
		else
			rc=$?
			cat "$raw" >> "$output"
			printf 'nft list table failed rc=%s\n' "$rc" >> "$output"
			printf 'nft_snapshot_failed\n' >> "$errors"
		fi
		rm -f "$raw"
	else
		printf 'nft unavailable\n' >> "$output"
		printf 'nft_unavailable\n' >> "$errors"
	fi

	printf '[listeners-7874-7892-9090]\n' >> "$output"
	if command -v ss >/dev/null 2>&1; then
		raw="${output}.listeners"
		if ss -lntup > "$raw" 2>&1; then
			awk 'NR == 1 || /:(7874|7892|9090)([[:space:]]|$)/' "$raw" >> "$output"
		else
			cat "$raw" >> "$output"
			printf 'listener_snapshot_failed\n' >> "$errors"
		fi
		rm -f "$raw"
	elif command -v netstat >/dev/null 2>&1; then
		raw="${output}.listeners"
		if netstat -lntup > "$raw" 2>&1; then
			awk 'NR <= 2 || /:(7874|7892|9090)([[:space:]]|$)/' "$raw" >> "$output"
		else
			cat "$raw" >> "$output"
			printf 'listener_snapshot_failed\n' >> "$errors"
		fi
		rm -f "$raw"
	else
		printf 'ss and netstat unavailable\n' >> "$output"
		printf 'listener_tool_unavailable\n' >> "$errors"
	fi

	[ ! -s "$errors" ]
}

takeover_logs() {
	local tmpdir status_rc boot_id uptime repair_ticket runtime_state boot_restore snapshot_rc system_events_available status_json_valid complete
	tmpdir="$(mktemp -d /tmp/localclash-takeover-logs.XXXXXX)" || {
		fail "tmpdir_failed" "无法创建网络接管诊断临时目录。"
		return 1
	}

	# Preserve kernel/firewall facts before Core bootstrap can create missing
	# workspace defaults, so the report starts from the first observed state.
	if takeover_snapshot "$tmpdir/snapshot.log" "$tmpdir/snapshot-errors.log"; then
		snapshot_rc=0
	else
		snapshot_rc=1
	fi
	if redact_diagnostic_stream < "$tmpdir/snapshot.log" > "$tmpdir/snapshot-redacted.log"; then
		mv -f "$tmpdir/snapshot-redacted.log" "$tmpdir/snapshot.log"
	else
		printf 'snapshot_redaction_failed\n' >> "$tmpdir/snapshot-errors.log"
		snapshot_rc=1
	fi
	system_events_available=false
	if command -v logread >/dev/null 2>&1; then
		if logread > "$tmpdir/logread.raw" 2>/dev/null; then
			if awk 'tolower($0) ~ /(localclash|firewall|fw4|netifd)/' "$tmpdir/logread.raw" > "$tmpdir/system-events.filtered" &&
				tail -n 200 "$tmpdir/system-events.filtered" > "$tmpdir/system-events.tail" &&
				redact_diagnostic_stream < "$tmpdir/system-events.tail" > "$tmpdir/system-events.log"; then
				system_events_available=true
			else
				: > "$tmpdir/system-events.log" 2>/dev/null || true
			fi
		else
			: > "$tmpdir/system-events.log" 2>/dev/null || true
		fi
	else
		: > "$tmpdir/system-events.log" 2>/dev/null || true
	fi

	if call_takeover status --json > "$tmpdir/current-status.json"; then
		status_rc=0
	else
		status_rc=$?
	fi
	status_json_valid=false
	if [ -s "$tmpdir/current-status.json" ] && jsonfilter -i "$tmpdir/current-status.json" -e '@.ok' >/dev/null 2>&1; then
		status_json_valid=true
	fi
	complete=false
	if [ "$snapshot_rc" -eq 0 ] && [ "$system_events_available" = true ] && [ "$status_rc" -eq 0 ] && [ "$status_json_valid" = true ]; then
		complete=true
	fi
	boot_id="$(cat "$BOOT_ID_FILE" 2>/dev/null || printf 'unknown')"
	uptime="$(cut -d. -f1 "$PROC_UPTIME" 2>/dev/null || printf '0')"
	case "$uptime" in
		''|*[!0-9]*) uptime=0 ;;
	esac
	repair_ticket=false
	runtime_state=false
	boot_restore=false
	takeover_repair_ticket_enabled && repair_ticket=true
	takeover_runtime_state_enabled && runtime_state=true
	boot_auto_restore_enabled && boot_restore=true

	printf '{"ok":true,"complete":%s,"privacy_notice":"诊断可能包含接口名、主机名或网络地址；复制给支持人员前请先检查。","path":"%s","boot_id":"%s","uptime_seconds":%s,"repair_ticket":%s,"runtime_state":%s,"boot_auto_restore":%s,"snapshot_exit_code":%s,"snapshot_errors":' "$complete" "$(json_escape "$TAKEOVER_LOG")" "$(json_escape "$boot_id")" "$uptime" "$repair_ticket" "$runtime_state" "$boot_restore" "$snapshot_rc"
	file_lines_json "$tmpdir/snapshot-errors.log"
	printf ',"events":'
	file_lines_json "$TAKEOVER_LOG"
	printf ',"current_snapshot":'
	file_lines_json "$tmpdir/snapshot.log"
	printf ',"system_events_available":%s,"recent_system_events":' "$system_events_available"
	file_lines_json "$tmpdir/system-events.log"
	printf ',"current_status_exit_code":%s,"current_status_json_valid":%s,"current_status":' "$status_rc" "$status_json_valid"
	if [ "$status_json_valid" = true ]; then
		cat "$tmpdir/current-status.json"
	else
		printf 'null'
	fi
	printf ',"current_status_output":'
	if [ "$status_json_valid" = true ]; then
		printf '[]'
	else
		file_lines_json "$tmpdir/current-status.json"
	fi
	printf '}\n'
	rm -rf "$tmpdir"
}

