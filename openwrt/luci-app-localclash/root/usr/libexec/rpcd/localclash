service_body() {
	local installed enabled running endpoint health_endpoint health_probe health_body healthy last_error
	installed=false
	enabled=false
	running=false
	healthy=false
	last_error=""
	if [ -x "$SERVICE" ]; then
		installed=true
		"$SERVICE" enabled >/dev/null 2>&1 && enabled=true
		if "$SERVICE" running mcp >/dev/null 2>&1; then
			running=true
		fi
	fi
	endpoint="$(mcp_endpoint)"
	health_endpoint="${endpoint%/mcp}/health"
	if [ "$running" = true ]; then
		health_probe="$(mcp_local_health_endpoint)"
		health_body="$(mcp_health_body "$health_probe" 2>/tmp/localclash-mcp-health.err || true)"
		if printf '%s' "$health_body" | grep -q '"status":"ok"'; then
			healthy=true
		else
			last_error="$(cat /tmp/localclash-mcp-health.err 2>/dev/null || true)"
			[ -n "$last_error" ] || last_error="MCP 健康检查未返回 ok。"
		fi
		rm -f /tmp/localclash-mcp-health.err
	fi
	printf '"service":{"name":"localclash-mcp","installed":%s,"enabled":%s,"running":%s,"pid":0},"mcp":{"endpoint":"%s","health_endpoint":"%s","healthy":%s,"last_error":"%s"}' "$installed" "$enabled" "$running" "$(json_escape "$endpoint")" "$(json_escape "$health_endpoint")" "$healthy" "$(json_escape "$last_error")"
}

mcp_health_body() {
	local url
	url="$1"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -T 2 -q -O - "$url"
	elif command -v wget >/dev/null 2>&1; then
		wget -T 2 -q -O - "$url"
	elif command -v curl >/dev/null 2>&1; then
		curl --max-time 2 -fsSL "$url"
	else
		return 127
	fi
}

mcp_host() {
	local host lan_ip
	host="${MCP_ADDR%:*}"
	if [ "$host" != "0.0.0.0" ] && [ "$host" != "::" ] && [ -n "$host" ]; then
		printf '%s\n' "$host"
		return 0
	fi
	if command -v uci >/dev/null 2>&1; then
		lan_ip="$(uci -q get network.lan.ipaddr 2>/dev/null || true)"
		if [ -n "$lan_ip" ]; then
			printf '%s\n' "$lan_ip"
			return 0
		fi
	fi
	if command -v ip >/dev/null 2>&1; then
		lan_ip="$(ip -4 addr show br-lan 2>/dev/null | sed -n 's/.*inet \([0-9.]*\)\/.*/\1/p' | head -n 1)"
		if [ -n "$lan_ip" ]; then
			printf '%s\n' "$lan_ip"
			return 0
		fi
	fi
	printf '192.168.1.1\n'
}

mcp_endpoint() {
	port="${MCP_ADDR##*:}"
	printf 'http://%s:%s/mcp\n' "$(mcp_host)" "$port"
}

mcp_local_health_endpoint() {
	local host port
	host="${MCP_ADDR%:*}"
	port="${MCP_ADDR##*:}"
	if [ "$host" = "0.0.0.0" ] || [ "$host" = "::" ] || [ -z "$host" ]; then
		host="127.0.0.1"
	fi
	printf 'http://%s:%s/health\n' "$host" "$port"
}

wait_for_mcp_ready() {
	local attempts current url body status_result service_running service_healthy
	attempts="$MCP_HEALTH_ATTEMPTS"
	case "$attempts" in
		""|*[!0-9]*|0)
			fail_with_details "mcp_health_attempts_invalid" "MCP 健康检查次数必须是正整数。" '"value":"'"$(json_escape "$attempts")"'"'
			return 1
			;;
	esac
	if ! command -v jsonfilter >/dev/null 2>&1; then
		fail "jsonfilter_missing" "需要 jsonfilter 验证 localclash-mcp 服务状态。"
		return 1
	fi
	url="$(mcp_local_health_endpoint)"
	current=1
	service_running=false
	service_healthy=false
	while [ "$current" -le "$attempts" ]; do
		service_running=false
		service_healthy=false
		if "$SERVICE" running mcp >/dev/null 2>&1; then
			service_running=true
			body="$(mcp_health_body "$url" 2>/dev/null || true)"
			if printf '%s' "$body" | grep -q '"status":"ok"'; then
				status_result="$(service_status 2>/dev/null || true)"
				service_running="$(jsonfilter -s "$status_result" -e '@.service.running' 2>/dev/null || true)"
				service_healthy="$(jsonfilter -s "$status_result" -e '@.mcp.healthy' 2>/dev/null || true)"
				if [ "$service_running" = "true" ] && [ "$service_healthy" = "true" ]; then
					printf '%s\n' "$status_result"
					return 0
				fi
			fi
		else
			service_running=false
			service_healthy=false
		fi
		if [ "$current" -lt "$attempts" ]; then
			sleep 1
		fi
		current=$((current + 1))
	done
	fail_with_details "mcp_health_timeout" "localclash-mcp 重启后未在限定时间内同时通过 procd 实例和健康检查。" '"attempts":'"$attempts"',"health_endpoint":"'"$(json_escape "$url")"'","service_running":"'"$(json_escape "$service_running")"'","mcp_healthy":"'"$(json_escape "$service_healthy")"'"'
	return 1
}

