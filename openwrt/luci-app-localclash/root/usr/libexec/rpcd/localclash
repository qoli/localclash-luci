dnsqualify_wan_ecs() {
	DNSQUALIFY_ECS_INTERFACE=""
	if ! command -v network_get_device >/dev/null 2>&1; then
		if [ ! -r /lib/functions/network.sh ]; then
			fail "dnsqualify_network_helper_missing" "无法读取 OpenWrt network.sh，不能确认当前 WAN 接口。"
