#!/bin/sh
set -u

STATE_DIR="${LOCALCLASH_TAKEOVER_STATE_DIR:-/tmp/localclash/router-takeover}"
NFT="${LOCALCLASH_NFT:-nft}"
INTERVAL_SECONDS="${LOCALCLASH_DNS_GUARD_INTERVAL_SECONDS:-5}"
LEASE_SECONDS="${LOCALCLASH_DNS_LEASE_SECONDS:-15}"
STATUS_FILE="${LOCALCLASH_DNS_GUARD_STATUS_FILE:-$STATE_DIR/dns-guard-status.json}"

json_escape() {
	printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

clear_inactive_status() {
	[ -z "$(takeover_generation 2>/dev/null || true)" ] || return 0
	rm -f "$STATUS_FILE" >/dev/null 2>&1 || true
}

write_status() {
	expected_generation="$1"
	shift
	[ -n "$expected_generation" ] || {
		clear_inactive_status
		return 0
	}
	[ "$(takeover_generation 2>/dev/null || true)" = "$expected_generation" ] || return 0
	result="$1"
	reason="$2"
	path="$3"
	tmp="${STATUS_FILE}.tmp.$$"
	mkdir -p "$STATE_DIR" || return 1
	printf '{"schema_version":1,"updated_at_epoch":%s,"result":"%s","reason":"%s","dns_path":"%s"}\n' \
		"$(date +%s)" "$(json_escape "$result")" "$(json_escape "$reason")" "$(json_escape "$path")" > "$tmp" || return 1
	chmod 600 "$tmp" 2>/dev/null || true
	if [ "$(takeover_generation 2>/dev/null || true)" != "$expected_generation" ]; then
		rm -f "$tmp"
		return 0
	fi
	mv -f "$tmp" "$STATUS_FILE"
}

valid_positive_integer() {
	case "$1" in ''|*[!0-9]*|0) return 1 ;; esac
	return 0
}

validate_settings() {
	valid_positive_integer "$INTERVAL_SECONDS" || return 1
	valid_positive_integer "$LEASE_SECONDS" || return 1
	[ "$LEASE_SECONDS" -gt "$INTERVAL_SECONDS" ] || return 1
}

takeover_generation() {
	[ -f "$STATE_DIR/status" ] && grep -qx applied "$STATE_DIR/status" 2>/dev/null || return 1
	[ -s "$STATE_DIR/generation" ] || return 1
	cat "$STATE_DIR/generation"
}

lease_rules_ready() {
	"$NFT" list chain inet fw4 localclash_dns_redirect 2>/dev/null | grep -q 'localClash DNS hijack to dnsmasq' || return 1
	"$NFT" list chain inet fw4 localclash_dns_redirect 2>/dev/null | grep -q 'localClash active DNS redirect' || return 1
	"$NFT" list chain inet fw4 nat_output 2>/dev/null | grep -q 'localClash active local DNS redirect' || return 1
	"$NFT" list set inet fw4 localclash_dns_active4 >/dev/null 2>&1 || return 1
	"$NFT" list set inet fw4 localclash_dns_active6 >/dev/null 2>&1 || return 1
}

runtime_lifecycle_active() {
	# The token follows only the critical managed Mihomo lifecycle. DNS answers
	# can vary while proxy exits change, so synthetic WAN queries are not used as
	# lifecycle evidence.
	runtime_state_file="$(cat "$STATE_DIR/runtime-state-file" 2>/dev/null || true)"
	[ -f "$runtime_state_file" ] || return 1
	[ "$(jsonfilter -i "$runtime_state_file" -e '@.state' 2>/dev/null || true)" = running ] || return 1
	runtime_boot_id="$(jsonfilter -i "$runtime_state_file" -e '@.boot_id' 2>/dev/null || true)"
	[ -n "$runtime_boot_id" ] && [ "$runtime_boot_id" = "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)" ] || return 1
	runtime_pid="$(jsonfilter -i "$runtime_state_file" -e '@.pid' 2>/dev/null || true)"
	valid_positive_integer "$runtime_pid" || return 1
	runtime_launcher="$(jsonfilter -i "$runtime_state_file" -e '@.launcher_path' 2>/dev/null || true)"
	[ -n "$runtime_launcher" ] || return 1
	[ "$(readlink "/proc/$runtime_pid/exe" 2>/dev/null || true)" = "$runtime_launcher" ] || return 1
	kill -0 "$runtime_pid" 2>/dev/null
}

renew_once() {
	generation_before="$(takeover_generation 2>/dev/null || true)"
	if [ -z "$generation_before" ]; then
		clear_inactive_status
		return 0
	fi
	if ! lease_rules_ready; then
		write_status "$generation_before" inactive takeover_rules_missing dnsmasq
		return 0
	fi
	if ! runtime_lifecycle_active; then
		write_status "$generation_before" failure mihomo_runtime_inactive lease_expiring
		return 1
	fi
	batch="$(mktemp /tmp/localclash-dns-lease.XXXXXX)" || {
		write_status "$generation_before" failure temporary_file_failed dnsmasq
		return 1
	}
	generation_after="$(takeover_generation 2>/dev/null || true)"
	if [ "$generation_after" != "$generation_before" ]; then
		rm -f "$batch"
		return 0
	fi
	{
		printf 'flush set inet fw4 localclash_dns_active4\n'
		printf 'flush set inet fw4 localclash_dns_active6\n'
		printf 'add element inet fw4 localclash_dns_active4 { 0.0.0.0/0 timeout %ss }\n' "$LEASE_SECONDS"
		printf 'add element inet fw4 localclash_dns_active6 { ::/0 timeout %ss }\n' "$LEASE_SECONDS"
	} > "$batch"
	if ! "$NFT" -f "$batch"; then
		rm -f "$batch"
		write_status "$generation_before" failure lease_refresh_failed lease_expiring
		return 1
	fi
	rm -f "$batch"
	write_status "$generation_before" success runtime_lease_refreshed mihomo
}

run_loop() {
	while :; do
		renew_once || true
		sleep "$INTERVAL_SECONDS" || exit 1
	done
}

validate_settings || {
	generation="$(takeover_generation 2>/dev/null || true)"
	write_status "$generation" failure invalid_guard_settings dnsmasq || true
	exit 1
}
command_name="${1:-run}"
case "$command_name" in
	run) run_loop ;;
	once) renew_once ;;
	*) printf 'usage: dns-guard [run|once]\n' >&2; exit 2 ;;
esac
