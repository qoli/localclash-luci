#!/bin/sh /etc/rc.common

START=97
STOP=8
USE_PROCD=1

start_service() {
	local enabled period enhanced_filter features arch state capability worker zone
	enabled="$(uci -q get localclash.pool_schedule.enabled 2>/dev/null)" || enabled=0
	[ "$enabled" = 1 ] || return 0
	period="$(uci -q get localclash.pool_schedule.period 2>/dev/null)" || period=15m
	enhanced_filter="$(uci -q get localclash.pool_schedule.enhanced_filter 2>/dev/null)" || enhanced_filter=0
	case "$enhanced_filter" in
		0|1) ;;
		*) echo "localClash 篩選增強配置无效" >&2; return 1 ;;
	esac
	case "$period" in
		5m|15m|30m|1h|daily-08) ;;
		*) echo "localClash 线路池更新周期无效" >&2; return 1 ;;
	esac
	case "$(uname -m)" in
		aarch64|arm64) arch=arm64 ;;
		x86_64|amd64) arch=amd64 ;;
		*) echo "localClash 线路池更新服务不支持此架构" >&2; return 1 ;;
	esac
	state="$(cd "${LOCALCLASH_STATE_DIR:-/root/localclash}" && pwd -P)" || return 1
	capability="$(LOCALCLASH_WORKDIR="$state" "${LOCALCLASH_CORE:-/usr/local/bin/localclash}" config pools --json)" || return 1
	[ "$(jsonfilter -s "$capability" -e '@.status.enabled' 2>/dev/null)" = true ] || return 0
	worker="$state/bin/linux-$arch/localclash-pools"
	[ -x "$worker" ] || {
		echo "localClash 线路池更新组件缺失" >&2
		return 1
	}
	if [ "$enhanced_filter" = 1 ]; then
		features="$("$worker" features 2>/dev/null)" &&
			[ "$(jsonfilter -s "$features" -e '@.enhanced_filter' 2>/dev/null)" = true ] || {
			echo "请更新 localClash 基础资产以使用篩選增強" >&2
			return 1
		}
	fi

	procd_open_instance pool_scheduler
	procd_set_param command "$worker" schedule --runtime "$state/.runtime/mihomo" --period "$period"
	[ "$enhanced_filter" != 1 ] || procd_append_param command --enhanced-filter
	zone="$(uci -q get system.@system[0].zonename 2>/dev/null)" || zone=
	[ -z "$zone" ] || procd_set_param env "TZ=$zone"
	procd_set_param respawn
	procd_set_param term_timeout 20
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger localclash system
}
