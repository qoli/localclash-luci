#!/bin/sh /etc/rc.common

START=96
STOP=9
USE_PROCD=1

WORKER="/usr/libexec/localclash/subscription-scheduler"
HELPER="/usr/libexec/rpcd/localclash"

start_service() {
	local enabled update_hour
	enabled="$(uci -q get localclash.subscription_schedule.enabled 2>/dev/null)" || {
		echo "localClash 订阅定时更新配置缺失" >&2
		return 1
	}
	[ "$enabled" = 1 ] || return 0
	update_hour="$(uci -q get localclash.subscription_schedule.update_hour 2>/dev/null)" || {
		echo "localClash 订阅定时更新时间配置缺失" >&2
		return 1
	}
	case "$update_hour" in
		[0-9]|1[0-9]|2[0-3]) ;;
		*) echo "localClash 订阅定时更新时间必须是 0 到 23 的整数小时" >&2; return 1 ;;
	esac
	[ -x "$WORKER" ] || {
		echo "localClash 订阅定时更新 worker 缺失：$WORKER" >&2
		return 1
	}
	[ -x "$HELPER" ] || {
		echo "localClash rpcd helper 缺失：$HELPER" >&2
		return 1
	}

	procd_open_instance subscription_scheduler
	procd_set_param command "$WORKER" run
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger localclash
}
