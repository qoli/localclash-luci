#!/bin/sh

case "$ACTION" in
	ifup|ifupdate) ;;
	*) exit 0 ;;
esac

HELPER="${LOCALCLASH_HELPER:-/usr/libexec/rpcd/localclash}"
[ -x "$HELPER" ] || exit 0

STAMP="${LOCALCLASH_RESTORE_HOTPLUG_STAMP:-/tmp/localclash-restore-hotplug.stamp}"
RESTORE_DELAY="${LOCALCLASH_RESTORE_DELAY:-8}"
case "$RESTORE_DELAY" in
	''|*[!0-9]*) exit 1 ;;
esac

# Each interface event gets a unique generation token. The worker from an
# earlier event exits when a newer event has arrived, so restoration begins
# only after the final ifup/ifupdate event has been quiet for RESTORE_DELAY.
TOKEN="$$"
STAMP_TMP="${STAMP}.${TOKEN}"
umask 077
printf '%s\n' "$TOKEN" > "$STAMP_TMP" || exit 1
mv -f "$STAMP_TMP" "$STAMP" || exit 1

takeover_trace() {
	local event="$1"
	shift
	LOCALCLASH_TAKEOVER_EVENT_ID="$TOKEN" "$HELPER" call takeover_trace iface_hotplug "$event" \
		action "${ACTION:-unknown}" interface "${INTERFACE:-unknown}" device "${DEVICE:-unknown}" \
		token "$TOKEN" delay_seconds "$RESTORE_DELAY" "$@" >/dev/null 2>&1 || true
}

takeover_trace scheduled result "" exit_code ""

(
	sleep "$RESTORE_DELAY"
	LATEST_TOKEN="$(cat "$STAMP" 2>/dev/null)" || exit 1
	if [ "$LATEST_TOKEN" != "$TOKEN" ]; then
		takeover_trace superseded result "" exit_code ""
		exit 0
	fi
	takeover_trace restore_started result "" exit_code ""
	if restore_result="$(LOCALCLASH_TAKEOVER_EVENT_ID="$TOKEN" LOCALCLASH_TAKEOVER_RESTORE_SOURCE=iface_hotplug "$HELPER" call takeover_restore 2>/dev/null)"; then
		takeover_trace restore_finished result success exit_code 0
	else
		rc=$?
		error_code="$(printf '%s\n' "$restore_result" | jsonfilter -e '@.code' 2>/dev/null)" || error_code=""
		case "$error_code" in
			task_locked) stage=task_lock ;;
			tmpdir_failed) stage=create_tmpdir ;;
			*) stage=takeover_restore ;;
		esac
		takeover_trace restore_finished result failure exit_code "$rc" stage "$stage" core_code "$error_code"
	fi
) &
